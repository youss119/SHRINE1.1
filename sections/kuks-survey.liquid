{% comment %}KUKS — Image + statistiques en cercles.{% endcomment %}
<section id="kuks-survey-{{ section.id }}" class="kuks-survey" style="background:{{ section.settings.background }};">
  <div class="kuks-survey__inner">
    <h2>{{ section.settings.heading }}</h2>
    <p class="kuks-survey__intro">{{ section.settings.intro }}</p>

    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1000 | image_tag: loading:'lazy', widths:'420,700,1000', sizes:'(max-width:749px) 100vw, 700px', alt:section.settings.heading }}
    {% endif %}

    <h3>{{ section.settings.subheading }}</h3>

    <div class="kuks-survey__stats">
      {% for block in section.blocks %}
        <article class="kuks-survey__stat" {{ block.shopify_attributes }}>
          <div class="kuks-survey__circle" style="--p: {{ block.settings.percent }};"><span>{{ block.settings.percent }}%</span></div>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.note != blank %}
      <p class="kuks-survey__note">{{ section.settings.note }}</p>
    {% endif %}
  </div>
</section>
<style>
#kuks-survey-{{ section.id }}{background:#fff;padding:24px 0 30px}
#kuks-survey-{{ section.id }} .kuks-survey__inner{width:min(100%,760px);margin:0 auto;padding:0 16px}
#kuks-survey-{{ section.id }} h2{margin:0 auto 12px;text-align:center;max-width:650px;font-size:31px;line-height:1.1;letter-spacing:-.03em;color:#111}
#kuks-survey-{{ section.id }} .kuks-survey__intro{margin:0 auto 16px;max-width:620px;text-align:center;font-size:13px;line-height:1.55;color:#333}
#kuks-survey-{{ section.id }} img{width:100%;display:block;border-radius:12px;margin:0 0 16px}
#kuks-survey-{{ section.id }} h3{margin:0 0 13px;font-size:25px;line-height:1.15;color:#111}
#kuks-survey-{{ section.id }} .kuks-survey__stats{display:grid;gap:0;border-top:1px solid #ececec}
#kuks-survey-{{ section.id }} .kuks-survey__stat{display:grid;grid-template-columns:66px minmax(0,1fr);gap:14px;align-items:center;padding:13px 0;border-bottom:1px solid #ececec}
#kuks-survey-{{ section.id }} .kuks-survey__circle{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#164a7d calc(var(--p)*1%),#e7edf3 0);position:relative}
#kuks-survey-{{ section.id }} .kuks-survey__circle::after{content:"";position:absolute;inset:6px;border-radius:50%;background:#fff}
#kuks-survey-{{ section.id }} .kuks-survey__circle span{position:relative;z-index:1;color:#164a7d;font-size:14px;font-weight:800}
#kuks-survey-{{ section.id }} .kuks-survey__stat p{margin:0;font-size:12.5px;line-height:1.5;color:#30363d}
#kuks-survey-{{ section.id }} .kuks-survey__note{margin:10px 0 0;font-size:9px;color:#6f7680}
@media(max-width:749px){
  #kuks-survey-{{ section.id }}{padding:20px 0 24px}
  #kuks-survey-{{ section.id }} .kuks-survey__inner{padding:0 13px}
  #kuks-survey-{{ section.id }} h2{font-size:23px}
  #kuks-survey-{{ section.id }} .kuks-survey__intro{font-size:11.3px}
  #kuks-survey-{{ section.id }} h3{font-size:20px}
  #kuks-survey-{{ section.id }} .kuks-survey__stat{grid-template-columns:58px minmax(0,1fr);gap:11px;padding:11px 0}
  #kuks-survey-{{ section.id }} .kuks-survey__circle{width:52px;height:52px}
  #kuks-survey-{{ section.id }} .kuks-survey__stat p{font-size:10.8px;line-height:1.45}
}
</style>
{% schema %}
{"name":"Statistiques - KUKS","max_blocks":5,"settings":[{"type":"color","id":"background","label":"Couleur du fond","default":"#ffffff"},{"type":"text","id":"heading","label":"Titre","default":"Les résultats qui les ont incités à repasser commande"},{"type":"textarea","id":"intro","label":"Introduction","default":"Nous avons recueilli les retours de clients afin de mieux comprendre l’impact d’une routine à l’urée 40 % sur leur quotidien."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"subheading","label":"Sous-titre","default":"Statistiques de satisfaction"},{"type":"text","id":"note","label":"Note en petit","default":"*Données à remplacer par vos propres résultats avant publication."}],"blocks":[{"type":"stat","name":"Pourcentage","settings":[{"type":"range","id":"percent","label":"Pourcentage","min":1,"max":100,"step":1,"default":87},{"type":"textarea","id":"text","label":"Texte","default":"La texture rugueuse leur semblait nettement adoucie."}]}],"presets":[{"name":"Statistiques - KUKS","blocks":[{"type":"stat"},{"type":"stat"},{"type":"stat"}]}]}
{% endschema %}