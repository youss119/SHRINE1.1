{% comment %}KUKS — séparateur de transition en fondu, pleine largeur.{% endcomment %}
<section
  id="kuks-gradient-divider-{{ section.id }}"
  class="kuks-gradient-divider"
  aria-hidden="true"
  style="
    --kuks-divider-start: {{ section.settings.start_color }};
    --kuks-divider-end: {{ section.settings.end_color }};
    --kuks-divider-h-desktop: {{ section.settings.height_desktop }}px;
    --kuks-divider-h-mobile: {{ section.settings.height_mobile }}px;
    --kuks-divider-stop: {{ section.settings.fade_start }}%;
    --kuks-divider-angle: {{ section.settings.angle }}deg;
  "
>
  <div class="kuks-gradient-divider__fade"></div>
</section>

<style>
#kuks-gradient-divider-{{ section.id }}{
  display:block !important;
  width:100% !important;
  min-height:var(--kuks-divider-h-desktop) !important;
  margin:0 !important;
  padding:0 !important;
  border:0 !important;
  line-height:0 !important;
  overflow:hidden !important;
  background:transparent !important;
}
#kuks-gradient-divider-{{ section.id }} .kuks-gradient-divider__fade{
  display:block !important;
  position:relative !important;
  left:50% !important;
  width:100vw !important;
  height:var(--kuks-divider-h-desktop) !important;
  min-height:var(--kuks-divider-h-desktop) !important;
  margin-left:-50vw !important;
  padding:0 !important;
  background:
    linear-gradient(
      var(--kuks-divider-angle),
      var(--kuks-divider-start) 0%,
      var(--kuks-divider-start) var(--kuks-divider-stop),
      var(--kuks-divider-end) 100%
    ) !important;
}
@media(max-width:749px){
  #kuks-gradient-divider-{{ section.id }}{
    min-height:var(--kuks-divider-h-mobile) !important;
  }
  #kuks-gradient-divider-{{ section.id }} .kuks-gradient-divider__fade{
    height:var(--kuks-divider-h-mobile) !important;
    min-height:var(--kuks-divider-h-mobile) !important;
  }
}
</style>

{% schema %}
{
  "name":"Fondu de couleur - KUKS",
  "settings":[
    {
      "type":"color",
      "id":"start_color",
      "label":"Couleur de départ",
      "default":"#ffffff"
    },
    {
      "type":"color",
      "id":"end_color",
      "label":"Couleur d’arrivée",
      "default":"#E7FBE3"
    },
    {
      "type":"range",
      "id":"height_desktop",
      "label":"Hauteur ordinateur",
      "min":20,
      "max":180,
      "step":5,
      "unit":"px",
      "default":70
    },
    {
      "type":"range",
      "id":"height_mobile",
      "label":"Hauteur mobile",
      "min":15,
      "max":120,
      "step":5,
      "unit":"px",
      "default":50
    },
    {
      "type":"range",
      "id":"fade_start",
      "label":"Début du fondu",
      "min":0,
      "max":80,
      "step":5,
      "unit":"%",
      "default":5
    },
    {
      "type":"range",
      "id":"angle",
      "label":"Angle du fondu",
      "min":0,
      "max":180,
      "step":5,
      "unit":"°",
      "default":180
    }
  ],
  "presets":[
    {
      "name":"Fondu de couleur - KUKS"
    }
  ]
}
{% endschema %}