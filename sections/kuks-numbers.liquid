{% comment %}KUKS — Chiffres clés sur fond bleu.{% endcomment %}
<section id="kuks-numbers-{{ section.id }}" class="kuks-numbers">
  <div class="kuks-numbers__inner">
    {% for block in section.blocks %}
      <article class="kuks-numbers__item" {{ block.shopify_attributes }}>
        <strong>{{ block.settings.number }}</strong>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </article>
    {% endfor %}
  </div>
</section>
<style>
#kuks-numbers-{{ section.id }}{background:#113d6b;padding:26px 0;color:#fff}
#kuks-numbers-{{ section.id }} .kuks-numbers__inner{width:min(100%,760px);margin:0 auto;padding:0 16px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0}
#kuks-numbers-{{ section.id }} .kuks-numbers__item strong{display:block;font-size:40px;line-height:1;font-weight:800;margin-bottom:7px}
#kuks-numbers-{{ section.id }} .kuks-numbers__item h3{margin:0 0 5px;font-size:17px;line-height:1.2;color:#fff}
#kuks-numbers-{{ section.id }} .kuks-numbers__item p{margin:0;max-width:610px;color:rgba(255,255,255,.78);font-size:12px;line-height:1.45}
@media(max-width:749px){
  #kuks-numbers-{{ section.id }}{padding:22px 0}
  #kuks-numbers-{{ section.id }} .kuks-numbers__inner{padding:0 14px;gap:20px}
  #kuks-numbers-{{ section.id }} .kuks-numbers__item strong{font-size:34px}
  #kuks-numbers-{{ section.id }} .kuks-numbers__item h3{font-size:14.5px}
  #kuks-numbers-{{ section.id }} .kuks-numbers__item p{font-size:10.8px}
}
</style>
{% schema %}
{
  "name":"Chiffres clés - KUKS",
  "max_blocks":6,
  "settings":[],
  "blocks":[
    {
      "type":"number",
      "name":"Chiffre",
      "settings":[
        {"type":"text","id":"number","label":"Chiffre","default":"40 %"},
        {"type":"text","id":"title","label":"Titre","default":"Concentration d’urée à usage intensif."},
        {"type":"textarea","id":"text","label":"Texte","default":"À cette concentration, l’urée agit comme kératolytique et aide à ramollir la kératine compacte."}
      ]
    }
  ],
  "presets":[{"name":"Chiffres clés - KUKS","blocks":[{"type":"number"},{"type":"number"},{"type":"number"}]}]
}
{% endschema %}