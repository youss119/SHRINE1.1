{% liquid
  assign bg = section.settings.background
  assign text = section.settings.text_color
%}

<style>
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .kuks-promo-timer {
    width: 100%;
    background: {{ bg }};
    color: {{ text }};
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .kuks-promo-timer__inner {
    width: 100%;
    min-height: 58px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 112px;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .kuks-promo-timer__copy {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .kuks-promo-timer__title {
    margin: 0 0 3px;
    color: inherit;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.18px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .kuks-promo-timer__subtitle {
    margin: 0;
    color: inherit;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9.8px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.08px;
    white-space: nowrap;
    opacity: .96;
  }

  #shopify-section-{{ section.id }} .kuks-promo-timer__clock {
    display: grid;
    grid-template-columns: 1fr 7px 1fr 7px 1fr;
    align-items: center;
    justify-items: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .kuks-promo-timer__unit {
    min-width: 27px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .kuks-promo-timer__number {
    display: block;
    margin: 0 0 2px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    color: inherit;
    font-variant-numeric: tabular-nums;
  }

  #shopify-section-{{ section.id }} .kuks-promo-timer__label {
    display: block;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 7px;
    font-weight: 700;
    line-height: 1;
    color: inherit;
    text-transform: uppercase;
    opacity: .92;
  }

  #shopify-section-{{ section.id }} .kuks-promo-timer__dot {
    font-size: 12px;
    line-height: 1;
    transform: translateY(-7px);
    opacity: .95;
  }

  @media (max-width: 390px) {
    #shopify-section-{{ section.id }} .kuks-promo-timer__inner {
      min-height: 54px;
      grid-template-columns: minmax(0, 1fr) 104px;
      gap: 6px;
      padding: 6px 9px;
    }

    #shopify-section-{{ section.id }} .kuks-promo-timer__title {
      font-size: 10.5px;
      margin-bottom: 3px;
      letter-spacing: -0.22px;
    }

    #shopify-section-{{ section.id }} .kuks-promo-timer__subtitle {
      font-size: 8.7px;
      letter-spacing: -0.16px;
    }

    #shopify-section-{{ section.id }} .kuks-promo-timer__number {
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .kuks-promo-timer__label {
      font-size: 6.5px;
    }

    #shopify-section-{{ section.id }} .kuks-promo-timer__unit {
      min-width: 24px;
    }
  }

  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .kuks-promo-timer__inner {
      max-width: 920px;
      margin: 0 auto;
      min-height: 64px;
      grid-template-columns: minmax(0, 1fr) 150px;
      gap: 18px;
      padding: 8px 18px;
    }

    #shopify-section-{{ section.id }} .kuks-promo-timer__title {
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .kuks-promo-timer__subtitle {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .kuks-promo-timer__number {
      font-size: 17px;
    }

    #shopify-section-{{ section.id }} .kuks-promo-timer__label {
      font-size: 8px;
    }
  }
</style>

<div
  class="kuks-promo-timer"
  data-promo-timer="{{ section.id }}"
  data-hours="{{ section.settings.timer_hours }}"
  role="region"
  aria-label="Offre promotionnelle"
>
  <div class="kuks-promo-timer__inner">
    <div class="kuks-promo-timer__copy">
      <p class="kuks-promo-timer__title">{{ section.settings.heading }}</p>
      <p class="kuks-promo-timer__subtitle">{{ section.settings.subheading }}</p>
    </div>

    <div class="kuks-promo-timer__clock" aria-label="Compte à rebours">
      <div class="kuks-promo-timer__unit">
        <span class="kuks-promo-timer__number" data-hours-value>00</span>
        <span class="kuks-promo-timer__label">H</span>
      </div>
      <span class="kuks-promo-timer__dot">•</span>
      <div class="kuks-promo-timer__unit">
        <span class="kuks-promo-timer__number" data-minutes-value>00</span>
        <span class="kuks-promo-timer__label">MIN</span>
      </div>
      <span class="kuks-promo-timer__dot">•</span>
      <div class="kuks-promo-timer__unit">
        <span class="kuks-promo-timer__number" data-seconds-value>00</span>
        <span class="kuks-promo-timer__label">SEC</span>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const root = document.querySelector('[data-promo-timer="{{ section.id }}"]');
    if (!root) return;

    const hoursEl = root.querySelector('[data-hours-value]');
    const minutesEl = root.querySelector('[data-minutes-value]');
    const secondsEl = root.querySelector('[data-seconds-value]');
    const durationHours = Math.max(1, parseInt(root.dataset.hours || '7', 10));

    let endAt = Date.now() + durationHours * 60 * 60 * 1000;

    const pad = (n) => String(n).padStart(2, '0');

    const render = () => {
      let remaining = Math.max(0, endAt - Date.now());

      if (remaining <= 0) {
        endAt = Date.now() + durationHours * 60 * 60 * 1000;
        remaining = endAt - Date.now();
      }

      const totalSeconds = Math.floor(remaining / 1000);
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      hoursEl.textContent = pad(hours);
      minutesEl.textContent = pad(minutes);
      secondsEl.textContent = pad(seconds);
    };

    render();
    setInterval(render, 1000);
  })();
</script>

{% schema %}
{
  "name": "Bannière promo + timer",
  "tag": "section",
  "class": "section-promo-countdown",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "ACHETEZ-EN 2, RECEVEZ 1 CADEAU 🎁"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Commandez maintenant : jusqu’à -50 % + cadeaux offerts"
    },
    {
      "type": "range",
      "id": "timer_hours",
      "label": "Durée du compte à rebours",
      "min": 1,
      "max": 24,
      "step": 1,
      "unit": "h",
      "default": 7
    },
    {
      "type": "color",
      "id": "background",
      "label": "Couleur de fond",
      "default": "#113D6B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Bannière promo + timer"
    }
  ]
}
{% endschema %}