{% comment %}KUKS — chiffres clés empilés sur fond bleu, éditables.{% endcomment %}
<section id="kuks-numbers-{{ section.id }}" class="kuks-numbers" style="background:{{ section.settings.background }};">
  <div class="kuks-numbers__inner">
    {% for block in section.blocks %}
      <article class="kuks-numbers__item" {{ block.shopify_attributes }}>
        <strong>{{ block.settings.number }}</strong>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </article>
    {% endfor %}
  </div>
</section>
<style>
#kuks-numbers-{{ section.id }}{background:#113d6b;padding:26px 0;color:#fff}
#kuks-numbers-{{ section.id }} .kuks-numbers__inner{width:min(100%,720px);margin:auto;padding:0 18px}
#kuks-numbers-{{ section.id }} .kuks-numbers__item{padding:18px 0;border-bottom:1px solid rgba(255,255,255,.15)}
#kuks-numbers-{{ section.id }} .kuks-numbers__item:last-child{border-bottom:0}
#kuks-numbers-{{ section.id }} strong{display:block;font-size:42px;line-height:1;font-weight:800;margin-bottom:8px}
#kuks-numbers-{{ section.id }} h3{margin:0 0 6px;font-size:17px;line-height:1.25;color:#fff}
#kuks-numbers-{{ section.id }} p{margin:0;max-width:610px;color:rgba(255,255,255,.75);font-size:12.5px;line-height:1.48}
@media(max-width:749px){#kuks-numbers-{{ section.id }}{padding:20px 0}#kuks-numbers-{{ section.id }} .kuks-numbers__inner{padding:0 18px}#kuks-numbers-{{ section.id }} strong{font-size:38px}#kuks-numbers-{{ section.id }} h3{font-size:15px}#kuks-numbers-{{ section.id }} p{font-size:11.5px}}
</style>
{% schema %}
{"name":"Chiffres clés - KUKS","max_blocks":6,"settings":[{"type":"color","id":"background","label":"Couleur de fond","default":"#113d6b"}],"blocks":[{"type":"number","name":"Chiffre","settings":[{"type":"text","id":"number","label":"Chiffre","default":"40 %"},{"type":"text","id":"title","label":"Titre","default":"Titre"},{"type":"textarea","id":"text","label":"Texte","default":"Description courte."}]}],"presets":[{"name":"Chiffres clés - KUKS","blocks":[{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}]}]}
{% endschema %}