{% comment %}KUKS — image éditable + texte, avec overlay optionnel.{% endcomment %}
<section id="kuks-change-{{ section.id }}" class="kuks-change" style="background:{{ section.settings.background }};">
  <div class="kuks-change__inner">
    {% if section.settings.image != blank %}
      <div class="kuks-change__media">
        {{ section.settings.image | image_url: width:1100 | image_tag: loading:'lazy', decoding:'async', fetchpriority:'low', widths:'420,700,900,1100', sizes:'(max-width:749px) 100vw, 700px', alt:section.settings.heading }}
        {% if section.settings.overlay != blank %}<span class="kuks-change__overlay">{{ section.settings.overlay }}</span>{% endif %}
      </div>
    {% endif %}
    <p class="kuks-change__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="kuks-change__text">{{ section.settings.text }}</div>
  </div>
</section>
<style>
#kuks-change-{{ section.id }}{background:#fff;padding:20px 0 28px}
#kuks-change-{{ section.id }} .kuks-change__inner{width:min(100%,720px);margin:auto;padding:0 14px}
#kuks-change-{{ section.id }} .kuks-change__media{position:relative;margin-bottom:14px}
#kuks-change-{{ section.id }} img{width:100%;display:block;border-radius:12px}
#kuks-change-{{ section.id }} .kuks-change__overlay{position:absolute;left:12px;bottom:12px;background:rgba(17,61,107,.9);color:#fff;border-radius:999px;padding:6px 10px;font-size:10px;font-weight:700}
#kuks-change-{{ section.id }} .kuks-change__eyebrow{margin:0 0 4px;font-size:10px;letter-spacing:.12em;color:#555;text-transform:uppercase}
#kuks-change-{{ section.id }} h2{margin:0 0 12px;font-size:31px;line-height:1.08;letter-spacing:-.035em;color:#111}
#kuks-change-{{ section.id }} .kuks-change__text{font-size:14px;line-height:1.72;color:#30353a}
@media(max-width:749px){#kuks-change-{{ section.id }} h2{font-size:27px}#kuks-change-{{ section.id }} .kuks-change__text{font-size:13.2px}}
</style>
{% schema %}
{"name":"Image + texte - KUKS","settings":[{"type":"color","id":"background","label":"Couleur du fond","default":"#ffffff"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"overlay","label":"Texte superposé optionnel"},{"type":"text","id":"eyebrow","label":"Petit surtitre","default":"UNE PEAU QUI RETROUVE UN ASPECT PLUS NET"},{"type":"textarea","id":"heading","label":"Titre","default":"Ce qui change quand vous intégrez la crème à votre routine"},{"type":"richtext","id":"text","label":"Texte","default":"<p>Ajoutez votre texte ici.</p>"}],"presets":[{"name":"Image + texte - KUKS"}]}
{% endschema %}