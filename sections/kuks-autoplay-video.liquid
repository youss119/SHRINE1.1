{% comment %}KUKS — vidéo + texte, autoplay silencieux, section éditable.{% endcomment %}
<section id="kuks-video-text-{{ section.id }}" class="kuks-video-text" style="background:{{ section.settings.background }};">
  <div class="kuks-video-text__inner">
    <div class="kuks-video-text__media">
      {% if section.settings.video != blank %}
        {% assign kuks_video_poster = section.settings.poster | default: section.settings.video.preview_image %}
        <video
          data-kuks-lazy-video
          muted
          loop
          playsinline
          preload="none"
          disablepictureinpicture
          {% if kuks_video_poster != blank %}poster="{{ kuks_video_poster | image_url: width: 1200 }}"{% endif %}
        >
          {% for source in section.settings.video.sources %}
            <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>
      {% elsif section.settings.poster != blank %}
        {{ section.settings.poster | image_url: width:1200 | image_tag: loading:'lazy', widths:'420,700,900,1200', sizes:'(max-width:749px) 100vw, 52vw', alt:section.settings.heading }}
        {% if request.design_mode %}<span class="kuks-video-text__hint">Ajoute ici ta vidéo Shopify : autoplay, muette et en boucle.</span>{% endif %}
      {% elsif request.design_mode %}
        <div class="kuks-video-text__placeholder">Sélectionne une vidéo dans les réglages de la section.</div>
      {% endif %}
    </div>
    <div class="kuks-video-text__copy">
      {% if section.settings.eyebrow != blank %}<p class="kuks-video-text__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="kuks-video-text__text">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.small_text != blank %}<p class="kuks-video-text__small">{{ section.settings.small_text }}</p>{% endif %}
    </div>
  </div>
</section>
<style>
#kuks-video-text-{{ section.id }}{padding:24px 0}
#kuks-video-text-{{ section.id }} .kuks-video-text__inner{width:min(100%,980px);margin:auto;padding:0 16px;display:grid;grid-template-columns:minmax(0,1.03fr) minmax(0,.97fr);gap:28px;align-items:center}
#kuks-video-text-{{ section.id }} .kuks-video-text__media{position:relative;border-radius:20px;overflow:hidden;background:#eef1f4;min-height:340px;box-shadow:0 8px 28px rgba(17,61,107,.06)}
#kuks-video-text-{{ section.id }} video,#kuks-video-text-{{ section.id }} img{display:block;width:100%;height:100%;min-height:340px;max-height:540px;object-fit:cover}
#kuks-video-text-{{ section.id }} .kuks-video-text__placeholder{min-height:340px;display:grid;place-items:center;text-align:center;padding:28px;color:#77808a;font-size:13px}
#kuks-video-text-{{ section.id }} .kuks-video-text__hint{position:absolute;left:12px;right:12px;bottom:12px;background:rgba(17,61,107,.92);color:#fff;padding:8px 10px;border-radius:12px;text-align:center;font-size:10px}
#kuks-video-text-{{ section.id }} .kuks-video-text__eyebrow{margin:0 0 8px;color:#113d6b;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
#kuks-video-text-{{ section.id }} h2{margin:0 0 12px;color:#171b22;font-size:34px;line-height:1.06;letter-spacing:-.04em}
#kuks-video-text-{{ section.id }} .kuks-video-text__text{color:#3f4852;font-size:14px;line-height:1.7}
#kuks-video-text-{{ section.id }} .kuks-video-text__text p{margin:0 0 10px}
#kuks-video-text-{{ section.id }} .kuks-video-text__small{margin:12px 0 0;color:#7a828b;font-size:11px;line-height:1.45}
@media(max-width:749px){
  #kuks-video-text-{{ section.id }}{padding:16px 0 18px}
  #kuks-video-text-{{ section.id }} .kuks-video-text__inner{grid-template-columns:1fr;gap:14px;padding:0 13px}
  #kuks-video-text-{{ section.id }} .kuks-video-text__media{min-height:0;border-radius:14px;aspect-ratio:4/5}
  #kuks-video-text-{{ section.id }} video,#kuks-video-text-{{ section.id }} img{min-height:0;height:100%;max-height:none}
  #kuks-video-text-{{ section.id }} .kuks-video-text__copy{padding:0 2px}
  #kuks-video-text-{{ section.id }} h2{font-size:24px;margin-bottom:9px}
  #kuks-video-text-{{ section.id }} .kuks-video-text__text{font-size:12px;line-height:1.58}
  #kuks-video-text-{{ section.id }} .kuks-video-text__small{font-size:10px}
}
</style>
<script>
(()=>{
  const root=document.getElementById('kuks-video-text-{{ section.id }}');
  if(!root)return;
  const v=root.querySelector('[data-kuks-lazy-video]');
  if(!v)return;

  let loaded=false;
  const loadVideo=()=>{
    if(!loaded){
      v.querySelectorAll('source[data-src]').forEach(source=>{
        source.src=source.dataset.src;
        source.removeAttribute('data-src');
      });
      v.load();
      loaded=true;
    }
    v.muted=true;
    const p=v.play();
    if(p&&p.catch)p.catch(()=>{});
  };

  const pauseVideo=()=>{ if(loaded && !v.paused) v.pause(); };

  if(window.Shopify && Shopify.designMode){
    loadVideo();
    return;
  }

  if('IntersectionObserver' in window){
    const io=new IntersectionObserver(entries=>{
      entries.forEach(entry=>{
        if(entry.isIntersecting) loadVideo();
        else pauseVideo();
      });
    },{rootMargin:'500px 0px',threshold:0.01});
    io.observe(root);
  }else{
    window.addEventListener('load',loadVideo,{once:true});
  }

  document.addEventListener('visibilitychange',()=>{
    if(document.hidden) pauseVideo();
    else if(root.getBoundingClientRect().top < window.innerHeight + 500) loadVideo();
  });
})();
</script>
{% schema %}
{"name":"Vidéo + texte - KUKS","settings":[{"type":"color","id":"background","label":"Couleur du fond","default":"#ffffff"},{"type":"video","id":"video","label":"Vidéo Shopify"},{"type":"image_picker","id":"poster","label":"Image d’attente"},{"type":"text","id":"eyebrow","label":"Petit surtitre","default":"UNE ROUTINE SIMPLE À INTÉGRER"},{"type":"textarea","id":"heading","label":"Titre","default":"Une application simple, directement chez vous"},{"type":"richtext","id":"text","label":"Texte","default":"<p>Appliquez une fine couche sur les zones ciblées et laissez la routine agir progressivement au fil des utilisations.</p><p>Cette section est entièrement modifiable : vidéo, texte et couleur de fond.</p>"},{"type":"textarea","id":"small_text","label":"Petit texte","default":"Vidéo en lecture automatique, sans son et en boucle."}],"presets":[{"name":"Vidéo + texte - KUKS"}]}
{% endschema %}