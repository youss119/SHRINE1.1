{% comment %}KUKS — vidéo autoplay silencieuse, boucle, éditable.{% endcomment %}
<section id="kuks-video-{{ section.id }}" class="kuks-video" style="background:{{ section.settings.background }};">
  <div class="kuks-video__inner">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.text != blank %}<div class="kuks-video__text">{{ section.settings.text }}</div>{% endif %}
    <div class="kuks-video__frame">
      {% if section.settings.video != blank %}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
      {% elsif section.settings.poster != blank %}
        {{ section.settings.poster | image_url: width:1200 | image_tag: loading:'lazy', widths:'420,700,900,1200', sizes:'(max-width:749px) 100vw, 720px', alt:section.settings.heading }}
        {% if request.design_mode %}<span class="kuks-video__hint">Choisissez une vidéo dans les réglages de cette section.</span>{% endif %}
      {% elsif request.design_mode %}
        <div class="kuks-video__placeholder">Ajoutez une vidéo Shopify : elle démarrera automatiquement, sans son, en boucle.</div>
      {% endif %}
    </div>
  </div>
</section>
<style>
#kuks-video-{{ section.id }}{padding:20px 0 26px}
#kuks-video-{{ section.id }} .kuks-video__inner{width:min(100%,760px);margin:auto;padding:0 14px}
#kuks-video-{{ section.id }} h2{margin:0 auto 8px;text-align:center;max-width:640px;font-size:29px;line-height:1.12;letter-spacing:-.035em;color:#171b22}
#kuks-video-{{ section.id }} .kuks-video__text{margin:0 auto 14px;max-width:580px;text-align:center;color:#626b75;font-size:12.5px;line-height:1.5}
#kuks-video-{{ section.id }} .kuks-video__frame{position:relative;border-radius:18px;overflow:hidden;background:#eef1f4;box-shadow:0 8px 30px rgba(17,61,107,.06)}
#kuks-video-{{ section.id }} video,#kuks-video-{{ section.id }} img{display:block;width:100%;height:auto;max-height:680px;object-fit:cover}
#kuks-video-{{ section.id }} .kuks-video__placeholder{min-height:320px;display:grid;place-items:center;padding:28px;text-align:center;color:#737b84;font-size:13px}
#kuks-video-{{ section.id }} .kuks-video__hint{position:absolute;left:12px;bottom:12px;background:rgba(17,61,107,.9);color:white;padding:7px 10px;border-radius:999px;font-size:10px}
@media(max-width:749px){
  #kuks-video-{{ section.id }}{padding:16px 0 20px}
  #kuks-video-{{ section.id }} h2{font-size:22px}
  #kuks-video-{{ section.id }} .kuks-video__text{font-size:10.8px}
  #kuks-video-{{ section.id }} .kuks-video__frame{border-radius:14px}
  #kuks-video-{{ section.id }} video,#kuks-video-{{ section.id }} img{max-height:560px}
}
</style>
<script>
(()=>{const r=document.getElementById('kuks-video-{{ section.id }}');if(!r)return;const v=r.querySelector('video');if(v){v.muted=true;v.setAttribute('muted','');v.setAttribute('playsinline','');const p=v.play();if(p&&p.catch)p.catch(()=>{})}})();
</script>
{% schema %}
{"name":"Vidéo autoplay - KUKS","settings":[{"type":"text","id":"heading","label":"Titre"},{"type":"richtext","id":"text","label":"Texte"},{"type":"video","id":"video","label":"Vidéo Shopify"},{"type":"image_picker","id":"poster","label":"Image d’attente (optionnelle)"},{"type":"color","id":"background","label":"Couleur de fond","default":"#ffffff"}],"presets":[{"name":"Vidéo autoplay - KUKS"}]}
{% endschema %}