{% comment %}KUKS — grands témoignages style éditorial, entièrement éditables.{% endcomment %}
<section id="kuks-stories-{{ section.id }}" class="kuks-stories" style="background:{{ section.settings.background }};">
  <div class="kuks-stories__inner">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.intro != blank %}<p class="kuks-stories__intro">{{ section.settings.intro }}</p>{% endif %}
    <div class="kuks-stories__viewport" data-vp>
      <div class="kuks-stories__track" data-track>
        {% for block in section.blocks %}
          <article class="kuks-stories__card{% if forloop.first %} is-active{% endif %}" data-card {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}<div class="kuks-stories__media">{{ block.settings.image | image_url: width:1100 | image_tag: loading:'lazy', widths:'420,700,900,1100', sizes:'(max-width:749px) 100vw, 680px', alt:block.settings.author }}</div>{% endif %}
            <div class="kuks-stories__body">
              <div class="kuks-stories__stars">{% for i in (1..5) %}<span class="{% if i > block.settings.rating %}is-empty{% endif %}">★</span>{% endfor %}</div>
              <h3>{{ block.settings.title }}</h3>
              <div class="kuks-stories__review-wrap" data-kuks-expand-wrap>
                <div class="kuks-stories__review is-collapsed" data-kuks-expand-text>{{ block.settings.review }}</div>
                <button type="button" class="kuks-stories__more" data-kuks-expand-btn aria-expanded="false">Voir plus</button>
              </div>
              <div class="kuks-stories__author"><strong>{{ block.settings.author }}</strong>{% if block.settings.meta != blank %}<span>{{ block.settings.meta }}</span>{% endif %}</div>
            </div>
          </article>
        {% endfor %}
      </div>
      {% if section.blocks.size > 1 %}
        <button class="kuks-stories__arrow kuks-stories__arrow--prev" type="button" data-prev aria-label="Précédent">‹</button>
        <button class="kuks-stories__arrow kuks-stories__arrow--next" type="button" data-next aria-label="Suivant">›</button>
      {% endif %}
    </div>
    {% if section.blocks.size > 1 %}<div class="kuks-stories__dots">{% for block in section.blocks %}<button type="button" class="{% if forloop.first %}is-active{% endif %}" data-dot="{{ forloop.index0 }}"></button>{% endfor %}</div>{% endif %}
  </div>
</section>
<style>
#kuks-stories-{{ section.id }}{background:#fff;padding:28px 0 30px;overflow:hidden}
#kuks-stories-{{ section.id }} .kuks-stories__inner{width:min(100%,720px);margin:auto;padding:0 14px}
#kuks-stories-{{ section.id }} h2{margin:0 auto 8px;text-align:center;max-width:650px;font-size:31px;line-height:1.12;letter-spacing:-.035em;color:#111}
#kuks-stories-{{ section.id }} .kuks-stories__intro{margin:0 auto 18px;text-align:center;max-width:590px;font-size:13px;line-height:1.45;color:#666}
#kuks-stories-{{ section.id }} .kuks-stories__viewport{position:relative;overflow:hidden;transition:height .28s ease}
#kuks-stories-{{ section.id }} .kuks-stories__track{display:flex;align-items:flex-start;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
#kuks-stories-{{ section.id }} .kuks-stories__track::-webkit-scrollbar{display:none}
#kuks-stories-{{ section.id }} .kuks-stories__card{flex:0 0 100%;scroll-snap-align:start;background:#f7f7f7;border-radius:18px;overflow:hidden;border:1px solid #ededed}
#kuks-stories-{{ section.id }} .kuks-stories__media{aspect-ratio:1.05;overflow:hidden;background:#eee}
#kuks-stories-{{ section.id }} .kuks-stories__media img{width:100%;height:100%;display:block;object-fit:cover}
#kuks-stories-{{ section.id }} .kuks-stories__body{padding:18px 20px 16px;text-align:center}
#kuks-stories-{{ section.id }} .kuks-stories__stars{display:flex;justify-content:center;gap:2px;margin-bottom:8px;color:#ffd400;font-size:18px}
#kuks-stories-{{ section.id }} .kuks-stories__stars .is-empty{opacity:.2}
#kuks-stories-{{ section.id }} h3{margin:0 0 12px;font-size:17px;line-height:1.35;color:#111}
#kuks-stories-{{ section.id }} .kuks-stories__review-wrap{text-align:left}
#kuks-stories-{{ section.id }} .kuks-stories__review{font-size:14px;line-height:1.72;color:#2f3338;text-align:left;transition:max-height .28s ease}
#kuks-stories-{{ section.id }} .kuks-stories__review.is-collapsed{max-height:315px;overflow:hidden}
#kuks-stories-{{ section.id }} .kuks-stories__review p{margin:0 0 12px}
#kuks-stories-{{ section.id }} .kuks-stories__more{display:none;margin:8px 0 0;padding:0;border:0;background:transparent;color:#113d6b;font:inherit;font-size:11.5px;line-height:1.2;font-weight:750;text-decoration:underline;text-underline-offset:2px;cursor:pointer}
#kuks-stories-{{ section.id }} .kuks-stories__more.is-visible{display:inline-flex}
#kuks-stories-{{ section.id }} .kuks-stories__author{margin-top:15px;padding-top:12px;border-top:1px solid #ddd;font-size:12px;font-style:italic;text-align:left}
#kuks-stories-{{ section.id }} .kuks-stories__author span{margin-left:6px;color:#777}
#kuks-stories-{{ section.id }} .kuks-stories__arrow{position:absolute;top:38%;z-index:4;width:34px;height:34px;border:0;border-radius:50%;background:#111b;color:#fff;font-size:26px;display:grid;place-items:center;padding:0}
#kuks-stories-{{ section.id }} .kuks-stories__arrow--prev{left:8px} #kuks-stories-{{ section.id }} .kuks-stories__arrow--next{right:8px}
#kuks-stories-{{ section.id }} .kuks-stories__dots{display:flex;justify-content:center;gap:8px;margin-top:13px}
#kuks-stories-{{ section.id }} .kuks-stories__dots button{width:6px;height:6px;border:0;border-radius:50%;background:#aaa;padding:0}
#kuks-stories-{{ section.id }} .kuks-stories__dots button.is-active{background:#111}
@media(max-width:749px){#kuks-stories-{{ section.id }} h2{font-size:28px}#kuks-stories-{{ section.id }} .kuks-stories__review{font-size:13.2px;line-height:1.7}}
</style>
<script>
(()=>{const r=document.getElementById('kuks-stories-{{ section.id }}');if(!r)return;const v=r.querySelector('[data-vp]'),t=r.querySelector('[data-track]'),c=[...r.querySelectorAll('[data-card]')],d=[...r.querySelectorAll('[data-dot]')],p=r.querySelector('[data-prev]'),n=r.querySelector('[data-next]');if(!v||!t||!c.length)return;const active=()=>{const x=t.scrollLeft;let b=0,m=1e9;c.forEach((e,i)=>{const q=Math.abs(e.offsetLeft-x);if(q<m){m=q;b=i}});return b};const set=i=>{i=Math.max(0,Math.min(c.length-1,i));c.forEach((e,j)=>e.classList.toggle('is-active',j===i));d.forEach((e,j)=>e.classList.toggle('is-active',j===i));requestAnimationFrame(()=>v.style.height=Math.ceil(c[i].getBoundingClientRect().height)+'px')};const go=i=>{i=Math.max(0,Math.min(c.length-1,i));t.scrollTo({left:c[i].offsetLeft,behavior:'smooth'});set(i)};let a;t.addEventListener('scroll',()=>{cancelAnimationFrame(a);a=requestAnimationFrame(()=>set(active()))},{passive:true});d.forEach((e,i)=>e.onclick=()=>go(i));if(p)p.onclick=()=>go(active()-1);if(n)n.onclick=()=>go(active()+1);window.addEventListener('resize',()=>set(active()));if(document.fonts?.ready)document.fonts.ready.then(()=>set(0));else set(0)})();
</script>
<script>
(()=>{const root=document.getElementById('kuks-stories-{{ section.id }}');if(!root)return;const setup=()=>{root.querySelectorAll('[data-kuks-expand-wrap]').forEach(wrap=>{const txt=wrap.querySelector('[data-kuks-expand-text]'),btn=wrap.querySelector('[data-kuks-expand-btn]');if(!txt||!btn)return;txt.classList.add('is-collapsed');requestAnimationFrame(()=>{const long=txt.scrollHeight>txt.clientHeight+2;btn.classList.toggle('is-visible',long);if(!long)txt.classList.remove('is-collapsed')});if(btn.dataset.bound==='1')return;btn.dataset.bound='1';btn.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',open?'false':'true');btn.textContent=open?'Voir plus':'Voir moins';txt.classList.toggle('is-collapsed',open);requestAnimationFrame(()=>window.dispatchEvent(new Event('resize')))})})};setup();document.addEventListener('shopify:section:load',setup)})();
</script>
{% schema %}
{"name":"Témoignages longs - KUKS","max_blocks":10,"settings":[{"type":"color","id":"background","label":"Couleur du fond","default":"#ffffff"},{"type":"textarea","id":"heading","label":"Titre","default":"Des histoires de peau, racontées sans filtre"},{"type":"textarea","id":"intro","label":"Introduction","default":"Des retours différents, avec un point commun : une routine simple et régulière."}],"blocks":[{"type":"story","name":"Témoignage long","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"range","id":"rating","label":"Note","min":1,"max":5,"step":1,"default":5},{"type":"text","id":"title","label":"Titre","default":"Titre du témoignage"},{"type":"richtext","id":"review","label":"Texte","default":"<p>Ajoutez votre témoignage ici.</p>"},{"type":"text","id":"author","label":"Nom","default":"Prénom N."},{"type":"text","id":"meta","label":"Détail","default":"Témoignage client"}]}],"presets":[{"name":"Témoignages longs - KUKS","blocks":[{"type":"story"},{"type":"story"},{"type":"story"}]}]}
{% endschema %}