{% comment %}KUKS — 3 problèmes avec onglets, image et texte éditables.{% endcomment %}
<section id="kuks-problems-{{ section.id }}" class="kuks-problems">
  <div class="kuks-problems__inner">
    <h2>{{ section.settings.heading }}</h2>
    <p class="kuks-problems__intro">{{ section.settings.intro }}</p>
    <div class="kuks-problems__tabs" role="tablist">
      {% for block in section.blocks %}<button type="button" class="{% if forloop.first %}is-active{% endif %}" data-tab="{{ forloop.index0 }}">{{ block.settings.label }}</button>{% endfor %}
    </div>
    {% for block in section.blocks %}
      <article class="kuks-problems__panel{% if forloop.first %} is-active{% endif %}" data-panel="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}{{ block.settings.image | image_url: width:1000 | image_tag: loading:'lazy', widths:'420,700,1000', sizes:'(max-width:749px) 100vw, 680px', alt:block.settings.title }}{% endif %}
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </article>
    {% endfor %}
  </div>
</section>
<style>
#kuks-problems-{{ section.id }}{background:#fff;padding:28px 0 30px}
#kuks-problems-{{ section.id }} .kuks-problems__inner{width:min(100%,720px);margin:auto;padding:0 14px;text-align:center}
#kuks-problems-{{ section.id }} h2{margin:0 auto 8px;font-size:31px;line-height:1.1;letter-spacing:-.035em;color:#111}
#kuks-problems-{{ section.id }} .kuks-problems__intro{margin:0 auto 18px;max-width:580px;font-size:13px;line-height:1.5;color:#4f555c}
#kuks-problems-{{ section.id }} .kuks-problems__tabs{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid #113d6b;border-radius:10px;overflow:hidden;margin-bottom:18px}
#kuks-problems-{{ section.id }} .kuks-problems__tabs button{border:0;background:#fff;color:#113d6b;padding:10px 5px;font-size:11px;font-weight:700}
#kuks-problems-{{ section.id }} .kuks-problems__tabs button.is-active{background:#113d6b;color:#fff}
#kuks-problems-{{ section.id }} .kuks-problems__panel{display:none} #kuks-problems-{{ section.id }} .kuks-problems__panel.is-active{display:block}
#kuks-problems-{{ section.id }} .kuks-problems__panel img{width:100%;max-height:520px;object-fit:cover;border-radius:12px;display:block;margin-bottom:16px}
#kuks-problems-{{ section.id }} h3{margin:0 auto 10px;max-width:580px;font-size:25px;line-height:1.18;color:#111}
#kuks-problems-{{ section.id }} .kuks-problems__panel p{margin:0 auto;max-width:610px;font-size:14px;line-height:1.68;color:#30353a}
@media(max-width:749px){#kuks-problems-{{ section.id }} h2{font-size:27px}#kuks-problems-{{ section.id }} h3{font-size:23px}#kuks-problems-{{ section.id }} .kuks-problems__panel p{font-size:13.2px}}
</style>
<script>
(()=>{const r=document.getElementById('kuks-problems-{{ section.id }}');if(!r)return;const t=[...r.querySelectorAll('[data-tab]')],p=[...r.querySelectorAll('[data-panel]')];t.forEach((x,i)=>x.onclick=()=>{t.forEach((e,j)=>e.classList.toggle('is-active',i===j));p.forEach((e,j)=>e.classList.toggle('is-active',i===j))})})();
</script>
{% schema %}
{"name":"3 problèmes - KUKS","max_blocks":3,"settings":[{"type":"textarea","id":"heading","label":"Titre","default":"Cette formule a été conçue pour répondre à trois problèmes de texture"},{"type":"textarea","id":"intro","label":"Introduction","default":"Trois situations différentes, avec un même point commun : une accumulation de kératine et une peau qui reste rugueuse."}],"blocks":[{"type":"problem","name":"Problème","settings":[{"type":"text","id":"label","label":"Onglet","default":"Problème 1"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Titre","default":"Titre du problème"},{"type":"textarea","id":"text","label":"Texte","default":"Décrivez le problème ici."}]}],"presets":[{"name":"3 problèmes - KUKS","blocks":[{"type":"problem"},{"type":"problem"},{"type":"problem"}]}]}
{% endschema %}