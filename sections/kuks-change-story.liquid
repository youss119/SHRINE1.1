{% comment %}KUKS — Image + texte compact.{% endcomment %}
<section id="kuks-change-{{ section.id }}" class="kuks-change">
  <div class="kuks-change__inner">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1000 | image_tag: loading:'lazy', widths:'420,700,1000', sizes:'(max-width:749px) 100vw, 700px', alt:section.settings.heading }}
    {% endif %}
    <p class="kuks-change__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div class="kuks-change__text">{{ section.settings.text }}</div>
  </div>
</section>
<style>
#kuks-change-{{ section.id }}{background:#fff;padding:18px 0 24px}
#kuks-change-{{ section.id }} .kuks-change__inner{width:min(100%,720px);margin:0 auto;padding:0 16px}
#kuks-change-{{ section.id }} img{width:100%;display:block;border-radius:8px;margin-bottom:13px}
#kuks-change-{{ section.id }} .kuks-change__eyebrow{margin:0 0 5px;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:#626873}
#kuks-change-{{ section.id }} h2{margin:0 0 10px;font-size:30px;line-height:1.08;letter-spacing:-.03em;color:#111}
#kuks-change-{{ section.id }} .kuks-change__text{font-size:13px;line-height:1.58;color:#333a42}
@media(max-width:749px){
  #kuks-change-{{ section.id }}{padding:14px 0 20px}
  #kuks-change-{{ section.id }} .kuks-change__inner{padding:0 13px}
  #kuks-change-{{ section.id }} h2{font-size:22px;line-height:1.12}
  #kuks-change-{{ section.id }} .kuks-change__text{font-size:11.6px;line-height:1.5}
}
</style>
{% schema %}
{
  "name":"Image + texte - KUKS",
  "settings":[
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"eyebrow","label":"Petit surtitre","default":"UNE PEAU QUI RETROUVE UN ASPECT PLUS NET"},
    {"type":"text","id":"heading","label":"Titre","default":"Qu’est-ce qui change lorsque vous commencez à utiliser la Crème Kératolytique Intensive ?"},
    {"type":"richtext","id":"text","label":"Texte","default":"<p>Le retrait professionnel peut coûter entre 150 € et 300 € par zone, et les imperfections peuvent revenir. Une routine à domicile permet de traiter plusieurs zones chaque soir avec un seul pot, sans multiplier les rendez-vous.</p>"}
  ],
  "presets":[{"name":"Image + texte - KUKS"}]
}
{% endschema %}