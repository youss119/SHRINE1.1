{% comment %}KUKS — garantie 60 jours, carte compacte éditable.{% endcomment %}
<section id="kuks-guarantee-{{ section.id }}" class="kuks-guarantee" style="background:{{ section.settings.background }};">
  <div class="kuks-guarantee__inner">
    <div class="kuks-guarantee__card" style="--card:{{ section.settings.card_background }};--accent:{{ section.settings.accent }};">
      <div class="kuks-guarantee__stars">★★★★★</div>
      <h2>{{ section.settings.heading }}</h2>
      <div class="kuks-guarantee__copy">{{ section.settings.text }}</div>
      <div class="kuks-guarantee__footer">
        <span>★★★★★</span>
        <strong>{{ section.settings.footer_text }}</strong>
      </div>
    </div>
  </div>
</section>
<style>
#kuks-guarantee-{{ section.id }}{padding:24px 0 34px}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__inner{width:min(100%,680px);margin:auto;padding:0 14px}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__card{overflow:hidden;border-radius:24px;background:var(--card);color:#fff;text-align:center;box-shadow:0 10px 34px rgba(17,61,107,.10)}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__stars{padding-top:24px;color:var(--accent);font-size:18px;letter-spacing:3px}
#kuks-guarantee-{{ section.id }} h2{margin:12px auto 16px;max-width:520px;padding:0 20px;color:#fff;font-size:30px;line-height:1.08;letter-spacing:-.03em}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__copy{max-width:540px;margin:0 auto;padding:0 24px 24px;color:rgba(255,255,255,.92);font-size:13px;line-height:1.62}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__copy p{margin:0 0 11px}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__footer{display:grid;gap:5px;background:rgba(255,255,255,.08);padding:14px 18px;border-top:1px solid rgba(255,255,255,.12)}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__footer span{color:var(--accent);letter-spacing:3px}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__footer strong{font-size:10px;letter-spacing:.08em;text-transform:uppercase}
@media(max-width:749px){
  #kuks-guarantee-{{ section.id }}{padding:18px 0 24px}
  #kuks-guarantee-{{ section.id }} .kuks-guarantee__card{border-radius:20px}
  #kuks-guarantee-{{ section.id }} .kuks-guarantee__stars{padding-top:20px;font-size:15px}
  #kuks-guarantee-{{ section.id }} h2{font-size:24px;margin:10px auto 13px}
  #kuks-guarantee-{{ section.id }} .kuks-guarantee__copy{font-size:11.5px;line-height:1.55;padding:0 18px 20px}
}
</style>
{% schema %}
{"name":"Garantie 60 jours - KUKS","settings":[{"type":"text","id":"heading","label":"Titre","default":"Garantie satisfaction de 60 jours"},{"type":"richtext","id":"text","label":"Texte","default":"<p>Nous vous laissons le temps d’intégrer la crème à votre routine et d’évaluer la texture de votre peau sur plusieurs semaines.</p><p>Si cette routine ne vous convient pas, vous disposez de 60 jours pour faire valoir la garantie selon les conditions de votre boutique.</p>"},{"type":"text","id":"footer_text","label":"Texte du bandeau","default":"60 JOURS POUR TESTER LA ROUTINE À VOTRE RYTHME"},{"type":"color","id":"background","label":"Couleur de fond","default":"#ffffff"},{"type":"color","id":"card_background","label":"Couleur de la carte","default":"#0f2f63"},{"type":"color","id":"accent","label":"Couleur des étoiles","default":"#f5c400"}],"presets":[{"name":"Garantie 60 jours - KUKS"}]}
{% endschema %}