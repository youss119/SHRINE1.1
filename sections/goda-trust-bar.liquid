{% liquid
  assign bg = section.settings.background
  assign text = section.settings.text_color
  assign right_sub = section.settings.right_subtext | default: '60 jours'
%}

<style>
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust {
    width: 100%;
    background: {{ bg }};
    color: {{ text }};
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__inner {
    width: calc(100% - 18px);
    max-width: 520px;
    margin: 0 auto;
    min-height: 56px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__item {
    position: relative;
    min-width: 0;
    height: 46px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 0 4px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 4px;
    right: 0;
    width: 1px;
    height: 38px;
    background: currentColor;
    opacity: .8;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__icon {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 18px;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__icon svg {
    display: block;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__stars {
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__stars span {
    display: block;
    color: currentColor;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.7px;
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__label {
    margin: 0;
    padding: 0;
    color: inherit;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9px;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.18px;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__sub {
    margin: 0;
    padding: 0;
    color: inherit;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 7.5px;
    font-weight: 400;
    line-height: 1;
    opacity: .82;
    white-space: nowrap;
  }

  @media (max-width: 390px) {
    #shopify-section-{{ section.id }} .kuks-goda-trust__inner {
      width: calc(100% - 24px);
      max-width: 330px;
      min-height: 52px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__item {
      height: 43px;
      gap: 2px;
      padding: 0 2px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__item:not(:last-child)::after {
      top: 4px;
      height: 35px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__icon,
    #shopify-section-{{ section.id }} .kuks-goda-trust__icon svg {
      width: 17px;
      height: 17px;
      flex-basis: 17px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__stars {
      height: 17px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__stars span {
      font-size: 14px;
      letter-spacing: -0.8px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__label {
      font-size: 8.4px;
      letter-spacing: -0.22px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__sub {
      font-size: 7px;
    }
  }

  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .kuks-goda-trust__inner {
      max-width: 620px;
      min-height: 60px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__item {
      height: 48px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__label {
      font-size: 10.5px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__sub {
      font-size: 8px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__icon,
    #shopify-section-{{ section.id }} .kuks-goda-trust__icon svg {
      width: 19px;
      height: 19px;
    }
  }
</style>

<div class="kuks-goda-trust" role="region" aria-label="Avantages boutique">
  <div class="kuks-goda-trust__inner">

    <div class="kuks-goda-trust__item">
      <div class="kuks-goda-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M3 7.5h10v8H3z"/>
          <path d="M13 10h3.3l2.7 2.7v2.8h-6"/>
          <circle cx="6.2" cy="17.2" r="1.7"/>
          <circle cx="16.8" cy="17.2" r="1.7"/>
          <path d="M4.8 10.2h4.8"/>
        </svg>
      </div>
      <p class="kuks-goda-trust__label">{{ section.settings.left_text }}</p>
    </div>

    <div class="kuks-goda-trust__item">
      <div class="kuks-goda-trust__stars" aria-hidden="true">
        <span>★★★★★</span>
      </div>
      <p class="kuks-goda-trust__label">{{ section.settings.center_text }}</p>
    </div>

    <div class="kuks-goda-trust__item">
      <div class="kuks-goda-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M7.5 7.2A7 7 0 1 1 5 12.5"/>
          <path d="M4.8 8.2 7.7 7l1 3"/>
          <rect x="9" y="9.2" width="6" height="5.8" rx=".7"/>
          <path d="M9 11.2h6"/>
        </svg>
      </div>
      <p class="kuks-goda-trust__label">{{ section.settings.right_text }}</p>
      <p class="kuks-goda-trust__sub">{{ right_sub }}</p>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Barre confiance GODA",
  "tag": "section",
  "class": "section-goda-trust",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "left_text",
      "label": "Texte gauche",
      "default": "Livraison offerte"
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Texte centre",
      "default": "Déjà +95 000 clients"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Texte droite",
      "default": "Retours faciles"
    },
    {
      "type": "text",
      "id": "right_subtext",
      "label": "Sous-texte retours",
      "default": "60 jours"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fond",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte et icônes",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Barre confiance GODA"
    }
  ]
}
{% endschema %}