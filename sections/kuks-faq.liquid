{% comment %}KUKS — FAQ finale éditable.{% endcomment %}
<section id="kuks-faq-{{ section.id }}" class="kuks-faq" style="background:{{ section.settings.background }};">
  <div class="kuks-faq__inner">
    <h2>{{ section.settings.heading }}</h2>
    <div class="kuks-faq__list">
      {% for block in section.blocks %}
        <details class="kuks-faq__item" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span><span class="kuks-faq__plus">+</span></summary>
          <div class="kuks-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>
<style>
#kuks-faq-{{ section.id }}{background:#fff;padding:32px 0 40px}
#kuks-faq-{{ section.id }} .kuks-faq__inner{width:min(100%,720px);margin:auto;padding:0 14px}
#kuks-faq-{{ section.id }} h2{margin:0 0 18px;text-align:center;font-size:31px;line-height:1.12;letter-spacing:-.035em;color:#111}
#kuks-faq-{{ section.id }} .kuks-faq__list{border-top:1px solid #e4e7ea}
#kuks-faq-{{ section.id }} .kuks-faq__item{border-bottom:1px solid #e4e7ea}
#kuks-faq-{{ section.id }} summary{list-style:none;display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:17px 2px;cursor:pointer;font-size:15px;font-weight:700;color:#1c2228}
#kuks-faq-{{ section.id }} summary::-webkit-details-marker{display:none}
#kuks-faq-{{ section.id }} .kuks-faq__plus{font-size:24px;font-weight:400;color:#113d6b;transition:transform .2s}
#kuks-faq-{{ section.id }} details[open] .kuks-faq__plus{transform:rotate(45deg)}
#kuks-faq-{{ section.id }} .kuks-faq__answer{padding:0 2px 17px;font-size:13px;line-height:1.62;color:#4c545c}
#kuks-faq-{{ section.id }} .kuks-faq__answer p{margin:0}
@media(max-width:749px){#kuks-faq-{{ section.id }} h2{font-size:28px}#kuks-faq-{{ section.id }} summary{font-size:14px}}
</style>
{% schema %}
{"name":"FAQ finale - KUKS","max_blocks":12,"settings":[{"type":"text","id":"heading","label":"Titre","default":"Vos questions, simplement"},{"type":"color","id":"background","label":"Couleur de fond","default":"#ffffff"}],"blocks":[{"type":"faq","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Votre question"},{"type":"richtext","id":"answer","label":"Réponse","default":"<p>Votre réponse.</p>"}]}],"presets":[{"name":"FAQ finale - KUKS","blocks":[{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"}]}]}
{% endschema %}