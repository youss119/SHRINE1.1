{% comment %}KUKS — Synthèse compacte en 4 cartes, modifiable bloc par bloc.{% endcomment %}
<section id="kuks-cards-{{ section.id }}" class="kuks-cards">
  <div class="kuks-cards__inner">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.intro != blank %}<p class="kuks-cards__intro">{{ section.settings.intro }}</p>{% endif %}
    <div class="kuks-cards__grid">
      {% for block in section.blocks %}
        <article class="kuks-cards__card" {{ block.shopify_attributes }}>
          <span class="kuks-cards__num">{{ block.settings.number }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
#kuks-cards-{{ section.id }}{background:#fff;padding:18px 0 24px}
#kuks-cards-{{ section.id }} .kuks-cards__inner{width:min(100%,760px);margin:0 auto;padding:0 16px}
#kuks-cards-{{ section.id }} h2{max-width:640px;margin:0 auto 7px;text-align:center;font-size:27px;line-height:1.12;letter-spacing:-.03em;color:#111;font-weight:700}
#kuks-cards-{{ section.id }} .kuks-cards__intro{max-width:560px;margin:0 auto 14px;text-align:center;font-size:12px;line-height:1.45;color:#626975}
#kuks-cards-{{ section.id }} .kuks-cards__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid #e1e6eb;border-radius:12px;overflow:hidden;background:#fff}
#kuks-cards-{{ section.id }} .kuks-cards__card{position:relative;min-width:0;padding:15px 13px 14px;border-right:1px solid #e1e6eb}
#kuks-cards-{{ section.id }} .kuks-cards__card:last-child{border-right:0}
#kuks-cards-{{ section.id }} .kuks-cards__num{display:inline-grid;place-items:center;min-width:25px;height:25px;padding:0 7px;margin-bottom:9px;border:1px solid #b8c5d3;border-radius:999px;color:#113d6b;font-size:9.5px;font-weight:700;letter-spacing:.06em}
#kuks-cards-{{ section.id }} h3{margin:0 0 5px;color:#113d6b;font-size:15px;line-height:1.18;font-weight:700}
#kuks-cards-{{ section.id }} .kuks-cards__card p{margin:0;color:#47505a;font-size:10.7px;line-height:1.42}
@media(max-width:749px){
  #kuks-cards-{{ section.id }}{padding:16px 0 21px}
  #kuks-cards-{{ section.id }} .kuks-cards__inner{padding:0 13px}
  #kuks-cards-{{ section.id }} h2{font-size:21px}
  #kuks-cards-{{ section.id }} .kuks-cards__intro{font-size:10.8px;margin-bottom:12px}
  #kuks-cards-{{ section.id }} .kuks-cards__grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  #kuks-cards-{{ section.id }} .kuks-cards__card{padding:13px 11px 12px;border-right:1px solid #e1e6eb;border-bottom:1px solid #e1e6eb}
  #kuks-cards-{{ section.id }} .kuks-cards__card:nth-child(2n){border-right:0}
  #kuks-cards-{{ section.id }} .kuks-cards__card:nth-last-child(-n+2){border-bottom:0}
  #kuks-cards-{{ section.id }} h3{font-size:13.5px}
  #kuks-cards-{{ section.id }} .kuks-cards__card p{font-size:9.8px;line-height:1.4}
}
</style>

{% schema %}
{
  "name":"4 cartes - KUKS",
  "max_blocks":4,
  "settings":[
    {"type":"text","id":"heading","label":"Titre","default":"Une routine simple, pensée en quatre étapes"},
    {"type":"textarea","id":"intro","label":"Introduction","default":"L’essentiel de la formule et de son utilisation, en un coup d’œil."}
  ],
  "blocks":[
    {
      "type":"card",
      "name":"Carte",
      "settings":[
        {"type":"text","id":"number","label":"Numéro / icône","default":"01"},
        {"type":"text","id":"title","label":"Titre","default":"Titre"},
        {"type":"textarea","id":"text","label":"Description","default":"Description courte."}
      ]
    }
  ],
  "presets":[{"name":"4 cartes - KUKS","blocks":[{"type":"card"},{"type":"card"},{"type":"card"},{"type":"card"}]}]
}
{% endschema %}