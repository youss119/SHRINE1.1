{% comment %}KUKS — preuve sociale, 2 photos visibles comme la référence mobile.{% endcomment %}
<section id="kuks-social-{{ section.id }}" class="kuks-social" style="background:{{ section.settings.background }};">
  <div class="kuks-social__inner">
    <h2>{{ section.settings.heading }}</h2>
    <div class="kuks-social__viewport" data-viewport>
      <div class="kuks-social__track" data-track>
        {% for block in section.blocks %}
          <figure class="kuks-social__item" data-slide {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width:900 | image_tag: loading:'lazy', widths:'360,540,720,900', sizes:'(max-width:749px) 45vw, 320px', alt:block.settings.alt }}
            {% else %}
              <div class="kuks-social__placeholder">Ajoutez une image</div>
            {% endif %}
          </figure>
        {% endfor %}
      </div>
      {% if section.blocks.size > 2 %}
        <button class="kuks-social__arrow kuks-social__arrow--prev" type="button" data-prev aria-label="Précédent">‹</button>
        <button class="kuks-social__arrow kuks-social__arrow--next" type="button" data-next aria-label="Suivant">›</button>
      {% endif %}
    </div>
    {% if section.blocks.size > 2 %}
      <div class="kuks-social__dots">
        {% for block in section.blocks %}
          <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}"></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
<style>
#kuks-social-{{ section.id }}{background:#fff;padding:20px 0 28px;overflow:hidden}
#kuks-social-{{ section.id }} .kuks-social__inner{width:min(100%,760px);margin:auto;padding:0 14px}
#kuks-social-{{ section.id }} h2{margin:0 auto 18px;max-width:660px;text-align:center;font-size:31px;line-height:1.12;letter-spacing:-.035em;color:#111;font-weight:800}
#kuks-social-{{ section.id }} .kuks-social__viewport{position:relative;overflow:hidden}
#kuks-social-{{ section.id }} .kuks-social__track{display:grid;grid-auto-flow:column;grid-auto-columns:calc(50% - 5px);gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch}
#kuks-social-{{ section.id }} .kuks-social__track::-webkit-scrollbar{display:none}
#kuks-social-{{ section.id }} .kuks-social__item{margin:0;aspect-ratio:.61;overflow:hidden;scroll-snap-align:start;background:#f2f2f2}
#kuks-social-{{ section.id }} .kuks-social__item img{width:100%;height:100%;display:block;object-fit:cover}
#kuks-social-{{ section.id }} .kuks-social__placeholder{height:100%;display:grid;place-items:center;color:#777}
#kuks-social-{{ section.id }} .kuks-social__arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:34px;height:34px;border:0;border-radius:50%;background:rgba(20,20,20,.68);color:#fff;font-size:26px;display:grid;place-items:center;padding:0}
#kuks-social-{{ section.id }} .kuks-social__arrow--prev{left:7px} #kuks-social-{{ section.id }} .kuks-social__arrow--next{right:7px}
#kuks-social-{{ section.id }} .kuks-social__dots{display:flex;justify-content:center;gap:8px;margin-top:13px}
#kuks-social-{{ section.id }} .kuks-social__dots button{width:6px;height:6px;border:0;border-radius:50%;padding:0;background:#9a9a9a}
#kuks-social-{{ section.id }} .kuks-social__dots button.is-active{background:#111}
@media(max-width:749px){#kuks-social-{{ section.id }} h2{font-size:27px;margin-bottom:16px}}
</style>
<script>
(()=>{const r=document.getElementById('kuks-social-{{ section.id }}');if(!r)return;const t=r.querySelector('[data-track]');const s=[...r.querySelectorAll('[data-slide]')];const d=[...r.querySelectorAll('[data-dot]')];const p=r.querySelector('[data-prev]'),n=r.querySelector('[data-next]');if(!t||!s.length)return;const idx=()=>{const x=t.scrollLeft;let b=0,m=1e9;s.forEach((e,i)=>{const q=Math.abs(e.offsetLeft-x);if(q<m){m=q;b=i}});return b};const go=i=>{i=Math.max(0,Math.min(s.length-1,i));t.scrollTo({left:s[i].offsetLeft,behavior:'smooth'});d.forEach((x,j)=>x.classList.toggle('is-active',j===i))};let a;t.addEventListener('scroll',()=>{cancelAnimationFrame(a);a=requestAnimationFrame(()=>d.forEach((x,j)=>x.classList.toggle('is-active',j===idx())))},{passive:true});d.forEach((x,i)=>x.onclick=()=>go(i));if(p)p.onclick=()=>go(idx()-1);if(n)n.onclick=()=>go(idx()+1)})();
</script>
{% schema %}
{"name":"Photos approuvées - KUKS","max_blocks":12,"settings":[{"type":"color","id":"background","label":"Couleur du fond","default":"#ffffff"},{"type":"textarea","id":"heading","label":"Titre","default":"Approuvé par celles et ceux qui ont choisi une routine plus simple"}],"blocks":[{"type":"image","name":"Photo","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"alt","label":"Texte alternatif","default":"Photo client"}]}],"presets":[{"name":"Photos approuvées - KUKS","blocks":[{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"}]}]}
{% endschema %}