{% liquid
  assign featured_product = section.settings.product
  assign media_1 = featured_product.media[1].preview_image
  assign media_2 = featured_product.media[2].preview_image
  assign media_3 = featured_product.media[3].preview_image
%}

<section class="kuks-home-gallery" style="--bg:{{ section.settings.background }};--text:{{ section.settings.text_color }};--accent:{{ section.settings.accent_color }};">
  <div class="page-width">
    <div class="kuks-home-gallery__head">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<div>{{ section.settings.text }}</div>{% endif %}
    </div>

    <div class="kuks-home-gallery__grid">
      {% for i in (1..3) %}
        {% liquid
          case i
            when 1
              assign current_image = media_1
            when 2
              assign current_image = media_2
            else
              assign current_image = media_3
          endcase
        %}
        {% if current_image != blank %}
          <a href="{{ featured_product.url }}" class="kuks-home-gallery__card">
            {{ current_image | image_url: width: 1000 | image_tag:
              loading: 'lazy',
              widths: '360, 540, 760, 1000',
              sizes: '(min-width: 900px) 33vw, 78vw',
              class: 'kuks-home-gallery__image'
            }}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if featured_product != blank %}
      <div class="kuks-home-gallery__cta">
        <div>
          <strong>{{ featured_product.title }}</strong>
          <span>{{ featured_product.price | money }}</span>
        </div>
        <a href="{{ featured_product.url }}">{{ section.settings.button_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .kuks-home-gallery{background:var(--bg);color:var(--text);padding:50px 0 64px}
  #shopify-section-{{ section.id }} .kuks-home-gallery__head{text-align:center;max-width:680px;margin:0 auto 26px}
  #shopify-section-{{ section.id }} .kuks-home-gallery__head h2{margin:0;font-size:clamp(30px,4vw,48px);line-height:1.05;letter-spacing:-.035em;color:var(--text)}
  #shopify-section-{{ section.id }} .kuks-home-gallery__head div{margin-top:12px;opacity:.7;font-size:16px}
  #shopify-section-{{ section.id }} .kuks-home-gallery__head p{margin:0}
  #shopify-section-{{ section.id }} .kuks-home-gallery__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  #shopify-section-{{ section.id }} .kuks-home-gallery__card{display:block;border-radius:22px;overflow:hidden;background:#fff}
  #shopify-section-{{ section.id }} .kuks-home-gallery__image{display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;transition:transform .25s ease}
  #shopify-section-{{ section.id }} .kuks-home-gallery__card:hover .kuks-home-gallery__image{transform:scale(1.015)}
  #shopify-section-{{ section.id }} .kuks-home-gallery__cta{margin-top:20px;padding:16px 18px;border:1px solid color-mix(in srgb,var(--text) 12%,transparent);border-radius:18px;display:flex;align-items:center;justify-content:space-between;gap:18px;background:rgba(255,255,255,.58)}
  #shopify-section-{{ section.id }} .kuks-home-gallery__cta>div{display:flex;flex-direction:column;gap:3px}
  #shopify-section-{{ section.id }} .kuks-home-gallery__cta strong{font-size:16px}
  #shopify-section-{{ section.id }} .kuks-home-gallery__cta span{font-size:14px;opacity:.62}
  #shopify-section-{{ section.id }} .kuks-home-gallery__cta a{background:var(--accent);color:#fff;border-radius:999px;text-decoration:none;font-weight:750;padding:12px 18px;white-space:nowrap}
  @media(max-width:749px){
    #shopify-section-{{ section.id }} .kuks-home-gallery{padding:34px 0 42px}
    #shopify-section-{{ section.id }} .kuks-home-gallery__head{text-align:left;margin-bottom:20px}
    #shopify-section-{{ section.id }} .kuks-home-gallery__grid{display:flex;overflow-x:auto;gap:10px;scroll-snap-type:x mandatory;padding-bottom:4px;margin-right:-1.5rem}
    #shopify-section-{{ section.id }} .kuks-home-gallery__card{min-width:78%;scroll-snap-align:start;border-radius:18px}
    #shopify-section-{{ section.id }} .kuks-home-gallery__cta{align-items:flex-end}
  }
{% endstyle %}

{% schema %}
{
  "name":"Accueil KUKS — Galerie",
  "tag":"section",
  "settings":[
    {"type":"product","id":"product","label":"Produit"},
    {"type":"text","id":"heading","label":"Titre","default":"K-Cream, sans compliquer votre routine."},
    {"type":"richtext","id":"text","label":"Texte","default":"<p>Une formule ciblée, une application simple, et les visuels que vous connaissez déjà de la page produit.</p>"},
    {"type":"text","id":"button_label","label":"Bouton","default":"Voir le produit"},
    {"type":"color","id":"background","label":"Fond","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Texte","default":"#113d6b"},
    {"type":"color","id":"accent_color","label":"Bouton","default":"#113d6b"}
  ],
  "presets":[{"name":"Accueil KUKS — Galerie"}]
}
{% endschema %}