{% comment %}KUKS — timeline compacte, cartes courtes et épurées.{% endcomment %}
<section id="kuks-timeline-{{ section.id }}" class="kuks-timeline" style="background:{{ section.settings.background }};">
  <div class="kuks-timeline__inner">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.intro != blank %}<p class="kuks-timeline__intro">{{ section.settings.intro }}</p>{% endif %}
    <div class="kuks-timeline__grid">
      {% for block in section.blocks %}
        <article class="kuks-timeline__card" {{ block.shopify_attributes }}>
          <div class="kuks-timeline__top">
            <span class="kuks-timeline__index">{{ forloop.index }}</span>
            <span class="kuks-timeline__period">{{ block.settings.period }}</span>
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
<style>
#kuks-timeline-{{ section.id }}{padding:22px 0}
#kuks-timeline-{{ section.id }} .kuks-timeline__inner{width:min(100%,820px);margin:auto;padding:0 14px}
#kuks-timeline-{{ section.id }} h2{margin:0 auto 6px;max-width:650px;text-align:center;font-size:30px;line-height:1.12;letter-spacing:-.035em;color:#171b22}
#kuks-timeline-{{ section.id }} .kuks-timeline__intro{margin:0 auto 15px;max-width:560px;text-align:center;color:#68707a;font-size:12.5px;line-height:1.45}
#kuks-timeline-{{ section.id }} .kuks-timeline__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
#kuks-timeline-{{ section.id }} .kuks-timeline__card{border:1px solid #e3e8ee;border-radius:16px;background:rgba(255,255,255,.86);padding:14px 13px;min-width:0;box-shadow:0 4px 16px rgba(17,61,107,.04)}
#kuks-timeline-{{ section.id }} .kuks-timeline__top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
#kuks-timeline-{{ section.id }} .kuks-timeline__index{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:#113d6b;color:#fff;font-size:10px;font-weight:800;flex:0 0 auto}
#kuks-timeline-{{ section.id }} .kuks-timeline__period{display:inline-flex;border:1px solid #ccd5df;border-radius:999px;padding:4px 8px;background:#fff;color:#4d5661;font-size:9.5px;line-height:1;white-space:nowrap}
#kuks-timeline-{{ section.id }} h3{margin:0 0 6px;color:#113d6b;font-size:15px;line-height:1.2;font-weight:700}
#kuks-timeline-{{ section.id }} .kuks-timeline__card p{margin:0;color:#4d5661;font-size:10.8px;line-height:1.42}
@media(max-width:749px){
  #kuks-timeline-{{ section.id }}{padding:18px 0}
  #kuks-timeline-{{ section.id }} h2{font-size:22px;margin-bottom:5px}
  #kuks-timeline-{{ section.id }} .kuks-timeline__intro{font-size:10.8px;margin-bottom:12px}
  #kuks-timeline-{{ section.id }} .kuks-timeline__grid{display:flex;overflow-x:auto;gap:9px;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:2px}
  #kuks-timeline-{{ section.id }} .kuks-timeline__grid::-webkit-scrollbar{display:none}
  #kuks-timeline-{{ section.id }} .kuks-timeline__card{flex:0 0 76%;scroll-snap-align:start;padding:13px 12px}
  #kuks-timeline-{{ section.id }} h3{font-size:14.5px}
  #kuks-timeline-{{ section.id }} .kuks-timeline__card p{font-size:10.4px}
}
</style>
{% schema %}
{"name":"Timeline compacte - KUKS","max_blocks":6,"settings":[{"type":"textarea","id":"heading","label":"Titre","default":"À quoi peut ressembler une utilisation quotidienne"},{"type":"textarea","id":"intro","label":"Introduction","default":"Une évolution progressive, sans prendre toute la page."},{"type":"color","id":"background","label":"Couleur de fond","default":"#ffffff"}],"blocks":[{"type":"step","name":"Étape","settings":[{"type":"text","id":"period","label":"Période","default":"Semaines 1–2"},{"type":"text","id":"title","label":"Titre","default":"Vous ressentez la différence"},{"type":"textarea","id":"text","label":"Texte","default":"Décrivez ici ce que la personne peut observer."}]}],"presets":[{"name":"Timeline compacte - KUKS","blocks":[{"type":"step"},{"type":"step"},{"type":"step"},{"type":"step"}]}]}
{% endschema %}