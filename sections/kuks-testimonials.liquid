{% comment %}
  KUKS — Avis clients séparés, carrousel mobile à hauteur dynamique.
{% endcomment %}

<section class="kuks-testimonials-section" id="kuks-testimonials-{{ section.id }}">
  <div class="kuks-testimonials-inner">
    <p class="kuks-testimonials-kicker">AVIS CLIENTS</p>

    <div class="kuks-testimonials-viewport" data-kuks-viewport>
      <div class="kuks-testimonials-track" role="list" data-kuks-track>

        <article class="kuks-testimonial-card is-active" role="listitem" data-kuks-card>
          <div class="kuks-testimonial-rating">
            <span class="kuks-green-stars" aria-label="5 étoiles">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </span>
          </div>

          <p class="kuks-testimonial-quote">{{ section.settings.review_1 | default: "« J'ai passé des décennies à les enlever une par une. Les patients revenaient sans cesse avec de nouvelles imperfections. La Crème Kératolytique Intensive a changé ma façon d'aborder le problème. L'urée à 40 % ramollit la kératine compactée de l'intérieur. J'ai vu des patients passer de dizaines de zones rugueuses à une peau visiblement plus lisse en deux ou trois mois. C'est désormais mon premier choix. »" }}</p>

          <div class="kuks-testimonial-author">
            <span class="kuks-avatar-frame">
              {% if section.settings.avatar_1 != blank %}
                {{ section.settings.avatar_1 | image_url: width: 200 | image_tag: loading: 'lazy', widths: '80,120,160,200', alt: section.settings.name_1 }}
              {% else %}
                <img src="https://cdn.shopify.com/s/files/1/1085/1844/1285/files/kuks-review-therese.png?v=1790623535" alt="" width="44" height="44" loading="lazy">
              {% endif %}
            </span>
            <div>
              <strong>{{ section.settings.name_1 | default: "Thérèse Ceron" }}</strong>
              <span>{{ section.settings.country_1 | default: "États-Unis" }}</span>
            </div>
            <span class="kuks-yellow-stars" aria-label="5 étoiles">★★★★★</span>
          </div>
        </article>

        <article class="kuks-testimonial-card" role="listitem" data-kuks-card>
          <div class="kuks-testimonial-rating">
            <span class="kuks-green-stars" aria-label="5 étoiles">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </span>
          </div>

          <p class="kuks-testimonial-quote">{{ section.settings.review_2 | default: "« J'en découvrais une nouvelle toutes les quelques semaines. Cou, poitrine, dos. J'ai arrêté de compter après 40. Mon médecin m'a dit qu'elles étaient inoffensives. Ça ne m'empêchait pas de détester la sensation qu'elles procuraient à chaque fois que je touchais ma peau. J'ai commencé à utiliser la Crème Kératolytique Intensive tous les soirs. Au bout de six semaines environ, les boutons rugueux sur mon cou se sont adoucis. Au bout de trois mois, j'ai passé la main sur ma poitrine et j'ai enfin senti une peau lisse. J'ai pleuré dans la salle de bain. Mon mari m'a demandé ce qui n'allait pas. Il n'y avait rien d'anormal. Enfin, quelque chose allait bien. »" }}</p>

          <div class="kuks-testimonial-author">
            <span class="kuks-avatar-frame">
              {% if section.settings.avatar_2 != blank %}
                {{ section.settings.avatar_2 | image_url: width: 200 | image_tag: loading: 'lazy', widths: '80,120,160,200', alt: section.settings.name_2 }}
              {% else %}
                <span class="kuks-avatar-fallback">RA</span>
              {% endif %}
            </span>
            <div>
              <strong>{{ section.settings.name_2 | default: "Rachel A." }}</strong>
              <span>{{ section.settings.country_2 | default: "États-Unis" }}</span>
            </div>
            <span class="kuks-yellow-stars" aria-label="5 étoiles">★★★★★</span>
          </div>
        </article>

        <article class="kuks-testimonial-card" role="listitem" data-kuks-card>
          <div class="kuks-testimonial-rating">
            <span class="kuks-green-stars" aria-label="5 étoiles">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </span>
          </div>

          <p class="kuks-testimonial-quote">{{ section.settings.review_3 | default: "« J'ai dépensé plus de 2 000 $ en cryothérapie en deux ans. Ils les ont fait disparaître par le froid. Ils sont réapparus. De nouveaux sont même apparus juste à côté. J'avais l'impression de jeter mon argent par les fenêtres. Une amie m'a parlé de la Crème Kératolytique Intensive. Je ne croyais pas qu'une crème puisse faire plus que ce que mon dermatologue avait réussi à faire. Mais après huit semaines, les boutons sur ma poitrine étaient moins visibles, plus lisses. Le mois dernier, j'ai porté un débardeur au match de foot de ma fille. Pour la première fois en quatre ans, je n'ai pas eu besoin d'enfiler un gilet en sortant. »" }}</p>

          <div class="kuks-testimonial-author">
            <span class="kuks-avatar-frame">
              {% if section.settings.avatar_3 != blank %}
                {{ section.settings.avatar_3 | image_url: width: 200 | image_tag: loading: 'lazy', widths: '80,120,160,200', alt: section.settings.name_3 }}
              {% else %}
                <span class="kuks-avatar-fallback">SL</span>
              {% endif %}
            </span>
            <div>
              <strong>{{ section.settings.name_3 | default: "Sarah L." }}</strong>
              <span>{{ section.settings.country_3 | default: "États-Unis" }}</span>
            </div>
            <span class="kuks-yellow-stars" aria-label="5 étoiles">★★★★★</span>
          </div>
        </article>

      </div>

      <span class="kuks-testimonials-fade" aria-hidden="true"></span>
    </div>

    <div class="kuks-testimonials-dots" aria-label="Navigation des avis">
      <button type="button" class="is-active" data-kuks-dot="0" aria-label="Avis 1"></button>
      <button type="button" data-kuks-dot="1" aria-label="Avis 2"></button>
      <button type="button" data-kuks-dot="2" aria-label="Avis 3"></button>
    </div>
  </div>
</section>

<style>
  #kuks-testimonials-{{ section.id }}{
    background:#fff;
    padding:14px 0 24px;
    overflow:hidden;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonials-inner{
    width:min(100%, 1180px);
    margin:0 auto;
    padding:0 16px;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonials-kicker{
    margin:0 0 9px;
    color:#8f96a0;
    font-size:9px;
    line-height:1;
    font-weight:700;
    letter-spacing:.12em;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonials-viewport{
    position:relative;
    overflow:hidden;
    transition:height .28s ease;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonials-track{
    display:flex;
    align-items:flex-start;
    gap:10px;
    overflow-x:auto;
    overflow-y:visible;
    scroll-snap-type:x mandatory;
    scroll-padding-left:0;
    -webkit-overflow-scrolling:touch;
    scrollbar-width:none;
    padding:1px 64px 5px 0;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonials-track::-webkit-scrollbar{
    display:none;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonial-card{
    flex:0 0 76%;
    min-width:0;
    height:auto;
    min-height:0;
    display:flex;
    flex-direction:column;
    align-self:flex-start;
    scroll-snap-align:start;
    padding:14px 14px 13px;
    border:1px solid #eceef1;
    border-radius:7px;
    background:#f7f8f9;
    color:#20242b;
    transition:opacity .22s ease, transform .22s ease;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonial-card:not(.is-active){
    opacity:.82;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonial-rating{
    display:flex;
    align-items:center;
    margin-bottom:13px;
  }

  #kuks-testimonials-{{ section.id }} .kuks-green-stars{
    display:inline-flex;
    gap:2px;
    line-height:1;
  }

  #kuks-testimonials-{{ section.id }} .kuks-green-stars span{
    display:grid;
    place-items:center;
    width:18px;
    height:18px;
    background:#00b67a;
    color:#fff;
    font-family:Arial,Helvetica,sans-serif;
    font-size:13px;
    line-height:1;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonial-quote{
    margin:0 0 14px;
    color:#242932;
    font-size:10.8px;
    line-height:1.47;
    font-weight:500;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonial-author{
    display:grid;
    grid-template-columns:44px minmax(0,1fr) auto;
    align-items:center;
    gap:9px;
    margin-top:12px;
    padding-top:10px;
    border-top:1px solid #e2e5e8;
  }

  #kuks-testimonials-{{ section.id }} .kuks-avatar-frame{
    width:44px;
    height:44px;
    border-radius:50%;
    overflow:hidden;
    display:grid;
    place-items:center;
    background:#edf0f3;
    border:1px solid #dfe3e7;
  }

  #kuks-testimonials-{{ section.id }} .kuks-avatar-frame img{
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
    object-position:center center;
  }

  #kuks-testimonials-{{ section.id }} .kuks-avatar-fallback{
    display:grid;
    place-items:center;
    width:100%;
    height:100%;
    color:#76808d;
    font-size:10px;
    font-weight:700;
    letter-spacing:.02em;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonial-author strong,
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-author div > span{
    display:block;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonial-author strong{
    color:#5a6069;
    font-size:10.8px;
    line-height:1.15;
    font-weight:700;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonial-author div > span{
    margin-top:2px;
    color:#9298a1;
    font-size:9.5px;
    line-height:1.1;
  }

  #kuks-testimonials-{{ section.id }} .kuks-yellow-stars{
    color:#ffc400;
    font-family:Arial,Helvetica,sans-serif;
    font-size:12px;
    letter-spacing:.4px;
    white-space:nowrap;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonials-fade{
    position:absolute;
    top:0;
    right:-1px;
    bottom:0;
    width:48px;
    pointer-events:none;
    z-index:4;
    background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.58) 55%,#fff 100%);
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonials-dots{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:6px;
    margin-top:9px;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonials-dots button{
    width:6px;
    height:6px;
    padding:0;
    border:0;
    border-radius:50%;
    background:#c7ccd3;
    cursor:pointer;
    transition:width .2s ease, background .2s ease;
  }

  #kuks-testimonials-{{ section.id }} .kuks-testimonials-dots button.is-active{
    width:17px;
    border-radius:999px;
    background:#26313f;
  }

  @media screen and (max-width:390px){
    #kuks-testimonials-{{ section.id }} .kuks-testimonials-inner{
      padding:0 13px;
    }

    #kuks-testimonials-{{ section.id }} .kuks-testimonial-card{
      flex-basis:74%;
      padding:13px;
    }

    #kuks-testimonials-{{ section.id }} .kuks-testimonial-quote{
      font-size:10.4px;
      line-height:1.45;
    }
  }

  @media screen and (min-width:750px){
    #kuks-testimonials-{{ section.id }}{
      padding:22px 0 34px;
    }

    #kuks-testimonials-{{ section.id }} .kuks-testimonials-inner{
      padding:0 28px;
    }

    #kuks-testimonials-{{ section.id }} .kuks-testimonials-viewport{
      height:auto !important;
      overflow:visible;
    }

    #kuks-testimonials-{{ section.id }} .kuks-testimonials-track{
      overflow:visible;
      padding-right:0;
      gap:14px;
    }

    #kuks-testimonials-{{ section.id }} .kuks-testimonial-card{
      flex:1 1 0;
      opacity:1 !important;
    }

    #kuks-testimonials-{{ section.id }} .kuks-testimonials-fade,
    #kuks-testimonials-{{ section.id }} .kuks-testimonials-dots{
      display:none;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById('kuks-testimonials-{{ section.id }}');
    if (!section) return;

    const viewport = section.querySelector('[data-kuks-viewport]');
    const track = section.querySelector('[data-kuks-track]');
    const cards = Array.from(section.querySelectorAll('[data-kuks-card]'));
    const dots = Array.from(section.querySelectorAll('[data-kuks-dot]'));
    if (!viewport || !track || !cards.length || !dots.length) return;

    const isDesktop = () => window.matchMedia('(min-width: 750px)').matches;

    const setViewportHeight = (index) => {
      if (isDesktop()) {
        viewport.style.height = '';
        return;
      }
      const card = cards[index];
      if (!card) return;
      viewport.style.height = Math.ceil(card.getBoundingClientRect().height + 6) + 'px';
    };

    const activate = (index) => {
      cards.forEach((card, i) => card.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
      requestAnimationFrame(() => setViewportHeight(index));
    };

    const nearestCard = () => {
      const trackLeft = track.getBoundingClientRect().left;
      let bestIndex = 0;
      let bestDistance = Infinity;

      cards.forEach((card, index) => {
        const distance = Math.abs(card.getBoundingClientRect().left - trackLeft);
        if (distance < bestDistance) {
          bestDistance = distance;
          bestIndex = index;
        }
      });

      return bestIndex;
    };

    let raf = null;
    track.addEventListener('scroll', () => {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => activate(nearestCard()));
    }, { passive:true });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        track.scrollTo({ left: cards[index].offsetLeft, behavior:'smooth' });
        activate(index);
      });
    });

    window.addEventListener('resize', () => activate(nearestCard()));

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => activate(0));
    } else {
      activate(0);
    }
  })();
</script>

