{% comment %}KUKS — FAQ finale éditable.{% endcomment %}
<section id="kuks-faq-{{ section.id }}" class="kuks-faq" style="background:{{ section.settings.background }};">
  <div class="kuks-faq__inner">
    {% if section.settings.eyebrow != blank %}<p class="kuks-faq__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <div class="kuks-faq__list">
      {% for block in section.blocks %}
        <details class="kuks-faq__item" {{ block.shopify_attributes }}>
          <summary>
            <span class="kuks-faq__qicon">A</span>
            <span class="kuks-faq__question">{{ block.settings.question }}</span>
            <span class="kuks-faq__chev">⌄</span>
          </summary>
          <div class="kuks-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>
<style>
#kuks-faq-{{ section.id }}{padding:28px 0 34px}
#kuks-faq-{{ section.id }} .kuks-faq__inner{width:min(100%,720px);margin:auto;padding:0 14px}
#kuks-faq-{{ section.id }} .kuks-faq__eyebrow{margin:0 0 6px;text-align:center;font-size:9px;font-weight:700;letter-spacing:.14em;color:#6d737b}
#kuks-faq-{{ section.id }} h2{margin:0 0 17px;text-align:center;font-size:29px;line-height:1.08;letter-spacing:-.035em;color:#111}
#kuks-faq-{{ section.id }} .kuks-faq__list{border-top:1px solid #e5e7ea}
#kuks-faq-{{ section.id }} .kuks-faq__item{border-bottom:1px solid #e5e7ea}
#kuks-faq-{{ section.id }} summary{list-style:none;display:grid;grid-template-columns:18px 1fr auto;gap:10px;align-items:center;padding:14px 2px;cursor:pointer;color:#171b20}
#kuks-faq-{{ section.id }} summary::-webkit-details-marker{display:none}
#kuks-faq-{{ section.id }} .kuks-faq__qicon{font-family:Georgia,serif;font-size:17px;line-height:1;color:#111}
#kuks-faq-{{ section.id }} .kuks-faq__question{font-size:13.5px;line-height:1.25;font-weight:750}
#kuks-faq-{{ section.id }} .kuks-faq__chev{font-size:16px;color:#555;transition:transform .2s}
#kuks-faq-{{ section.id }} details[open] .kuks-faq__chev{transform:rotate(180deg)}
#kuks-faq-{{ section.id }} .kuks-faq__answer{padding:0 28px 15px;font-size:12.5px;line-height:1.58;color:#4f565e}
#kuks-faq-{{ section.id }} .kuks-faq__answer p{margin:0 0 8px}
@media(max-width:749px){
  #kuks-faq-{{ section.id }}{padding:24px 0 30px}
  #kuks-faq-{{ section.id }} h2{font-size:24px}
  #kuks-faq-{{ section.id }} .kuks-faq__question{font-size:12.2px}
  #kuks-faq-{{ section.id }} .kuks-faq__answer{font-size:11.3px;line-height:1.55;padding-left:28px;padding-right:12px}
}
</style>
{% schema %}
{"name":"FAQ finale - KUKS","max_blocks":12,"settings":[{"type":"color","id":"background","label":"Couleur du fond","default":"#ffffff"},{"type":"text","id":"eyebrow","label":"Petit surtitre","default":"VOS QUESTIONS ONT TROUVÉ RÉPONSE"},{"type":"text","id":"heading","label":"Titre","default":"Foire aux questions"}],"blocks":[{"type":"faq","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Votre question"},{"type":"richtext","id":"answer","label":"Réponse","default":"<p>Votre réponse.</p>"}]}],"presets":[{"name":"FAQ finale - KUKS","blocks":[{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"},{"type":"faq"}]}]}
{% endschema %}