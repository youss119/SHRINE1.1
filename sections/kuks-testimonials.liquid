{% comment %}
  KUKS — Avis clients séparés, entièrement modifiables depuis l'éditeur Shopify.
{% endcomment %}

<section class="kuks-testimonials-section" id="kuks-testimonials-{{ section.id }}" style="background:{{ section.settings.background }};">
  <div class="kuks-testimonials-inner">
    <p class="kuks-testimonials-kicker">{{ section.settings.heading }}</p>

    <div class="kuks-testimonials-viewport" data-kuks-viewport>
      <div class="kuks-testimonials-track" role="list" data-kuks-track>
        {% for block in section.blocks %}
          <article
            class="kuks-testimonial-card{% if forloop.first %} is-active{% endif %}"
            role="listitem"
            data-kuks-card
            {{ block.shopify_attributes }}
          >
            <div class="kuks-testimonial-rating">
              <span class="kuks-green-stars" aria-label="{{ block.settings.rating }} étoiles">
                {% for i in (1..5) %}
                  <span class="{% if i > block.settings.rating %}is-empty{% endif %}">★</span>
                {% endfor %}
              </span>
            </div>

            <div class="kuks-testimonial-expand" data-kuks-expand-wrap>
              <p class="kuks-testimonial-quote is-collapsed" data-kuks-expand-text>{{ block.settings.review }}</p>
              <button type="button" class="kuks-review-more" data-kuks-expand-btn aria-expanded="false">Voir plus</button>
            </div>

            <div class="kuks-testimonial-author">
              <span class="kuks-avatar-frame">
                {% if block.settings.avatar != blank %}
                  {{ block.settings.avatar
                    | image_url: width: 240
                    | image_tag:
                      loading: 'lazy',
                      widths: '88,132,176,240',
                      alt: block.settings.name
                  }}
                {% else %}
                  <span class="kuks-avatar-fallback">{{ block.settings.name | slice: 0, 2 | upcase }}</span>
                {% endif %}
              </span>

              <div>
                <strong>{{ block.settings.name }}</strong>
                <span>{{ block.settings.country }}</span>
              </div>

              <span class="kuks-yellow-stars" aria-label="{{ block.settings.rating }} étoiles">
                {% for i in (1..5) %}{% if i <= block.settings.rating %}★{% endif %}{% endfor %}
              </span>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <span class="kuks-testimonials-fade" aria-hidden="true"></span>
      {% endif %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="kuks-testimonials-dots" aria-label="Navigation des avis">
        {% for block in section.blocks %}
          <button
            type="button"
            class="{% if forloop.first %}is-active{% endif %}"
            data-kuks-dot="{{ forloop.index0 }}"
            aria-label="Avis {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #kuks-testimonials-{{ section.id }}{
    background:#fff;
    padding:14px 0 24px;
    overflow:hidden;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonials-inner{
    width:min(100%,1180px);
    margin:0 auto;
    padding:0 16px;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonials-kicker{
    margin:0 0 9px;
    color:#8f96a0;
    font-size:9px;
    line-height:1;
    font-weight:700;
    letter-spacing:.12em;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonials-viewport{
    position:relative;
    overflow:hidden;
    transition:height .28s ease;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonials-track{
    display:flex;
    align-items:flex-start;
    gap:10px;
    overflow-x:auto;
    overflow-y:visible;
    scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
    scrollbar-width:none;
    padding:1px 64px 5px 0;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonials-track::-webkit-scrollbar{display:none}
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-card{
    flex:0 0 76%;
    min-width:0;
    height:auto;
    min-height:0;
    align-self:flex-start;
    display:flex;
    flex-direction:column;
    scroll-snap-align:start;
    padding:14px 14px 13px;
    border:1px solid #eceef1;
    border-radius:7px;
    background:#f7f8f9;
    color:#20242b;
    transition:opacity .22s ease;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-card:not(.is-active){opacity:.82}
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-rating{margin-bottom:13px}
  #kuks-testimonials-{{ section.id }} .kuks-green-stars{
    display:inline-flex;
    gap:2px;
    line-height:1;
  }
  #kuks-testimonials-{{ section.id }} .kuks-green-stars span{
    display:grid;
    place-items:center;
    width:18px;
    height:18px;
    background:#00b67a;
    color:#fff;
    font-family:Arial,Helvetica,sans-serif;
    font-size:13px;
  }
  #kuks-testimonials-{{ section.id }} .kuks-green-stars span.is-empty{opacity:.18}
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-expand{margin:0 0 14px}
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-quote{
    margin:0;
    color:#242932;
    font-size:10.8px;
    line-height:1.47;
    font-weight:500;
    transition:max-height .28s ease;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-quote.is-collapsed{
    max-height:190px;
    overflow:hidden;
  }
  #kuks-testimonials-{{ section.id }} .kuks-review-more{
    display:none;
    margin:8px 0 0;
    padding:0;
    border:0;
    background:transparent;
    color:#113d6b;
    font:inherit;
    font-size:10.5px;
    line-height:1.2;
    font-weight:750;
    text-decoration:underline;
    text-underline-offset:2px;
    cursor:pointer;
  }
  #kuks-testimonials-{{ section.id }} .kuks-review-more.is-visible{display:inline-flex}
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-author{
    display:grid;
    grid-template-columns:44px minmax(0,1fr) auto;
    align-items:center;
    gap:9px;
    margin-top:12px;
    padding-top:10px;
    border-top:1px solid #e2e5e8;
  }
  #kuks-testimonials-{{ section.id }} .kuks-avatar-frame{
    width:44px;
    height:44px;
    border-radius:50%;
    overflow:hidden;
    display:grid;
    place-items:center;
    background:#edf0f3;
    border:1px solid #dfe3e7;
  }
  #kuks-testimonials-{{ section.id }} .kuks-avatar-frame img{
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
    object-position:center;
  }
  #kuks-testimonials-{{ section.id }} .kuks-avatar-fallback{
    color:#76808d;
    font-size:10px;
    font-weight:700;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-author strong,
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-author div>span{display:block}
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-author strong{
    color:#5a6069;
    font-size:10.8px;
    line-height:1.15;
    font-weight:700;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonial-author div>span{
    margin-top:2px;
    color:#9298a1;
    font-size:9.5px;
  }
  #kuks-testimonials-{{ section.id }} .kuks-yellow-stars{
    color:#ffc400;
    font-family:Arial,Helvetica,sans-serif;
    font-size:12px;
    letter-spacing:.4px;
    white-space:nowrap;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonials-fade{
    position:absolute;
    top:0;
    right:-1px;
    bottom:0;
    width:48px;
    pointer-events:none;
    z-index:4;
    background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.58) 55%,#fff 100%);
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonials-dots{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:6px;
    margin-top:9px;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonials-dots button{
    width:6px;
    height:6px;
    padding:0;
    border:0;
    border-radius:50%;
    background:#c7ccd3;
    cursor:pointer;
    transition:width .2s ease,background .2s ease;
  }
  #kuks-testimonials-{{ section.id }} .kuks-testimonials-dots button.is-active{
    width:17px;
    border-radius:999px;
    background:#26313f;
  }
  @media screen and (max-width:390px){
    #kuks-testimonials-{{ section.id }} .kuks-testimonials-inner{padding:0 13px}
    #kuks-testimonials-{{ section.id }} .kuks-testimonial-card{
      flex-basis:74%;
      padding:13px;
    }
    #kuks-testimonials-{{ section.id }} .kuks-testimonial-quote{
      font-size:10.4px;
      line-height:1.45;
    }
  }
  @media screen and (min-width:750px){
    #kuks-testimonials-{{ section.id }}{padding:22px 0 34px}
    #kuks-testimonials-{{ section.id }} .kuks-testimonials-inner{padding:0 28px}
    #kuks-testimonials-{{ section.id }} .kuks-testimonials-viewport{
      height:auto!important;
      overflow:visible;
    }
    #kuks-testimonials-{{ section.id }} .kuks-testimonials-track{
      overflow:visible;
      padding-right:0;
      gap:14px;
      flex-wrap:wrap;
    }
    #kuks-testimonials-{{ section.id }} .kuks-testimonial-card{
      flex:1 1 calc(33.333% - 10px);
      opacity:1!important;
    }
    #kuks-testimonials-{{ section.id }} .kuks-testimonials-fade,
    #kuks-testimonials-{{ section.id }} .kuks-testimonials-dots{display:none}
  }
</style>

<script>
  (() => {
    const section = document.getElementById('kuks-testimonials-{{ section.id }}');
    if (!section) return;

    const viewport = section.querySelector('[data-kuks-viewport]');
    const track = section.querySelector('[data-kuks-track]');
    const cards = Array.from(section.querySelectorAll('[data-kuks-card]'));
    const dots = Array.from(section.querySelectorAll('[data-kuks-dot]'));
    if (!viewport || !track || !cards.length) return;

    const isDesktop = () => window.matchMedia('(min-width:750px)').matches;

    const setViewportHeight = (index) => {
      if (isDesktop()) {
        viewport.style.height = '';
        return;
      }
      const card = cards[index];
      if (card) viewport.style.height = Math.ceil(card.getBoundingClientRect().height + 6) + 'px';
    };

    const activate = (index) => {
      cards.forEach((card,i) => card.classList.toggle('is-active',i===index));
      dots.forEach((dot,i) => dot.classList.toggle('is-active',i===index));
      requestAnimationFrame(() => setViewportHeight(index));
    };

    const nearestCard = () => {
      const left = track.getBoundingClientRect().left;
      let best = 0;
      let dist = Infinity;
      cards.forEach((card,index) => {
        const d = Math.abs(card.getBoundingClientRect().left-left);
        if (d < dist) { dist=d; best=index; }
      });
      return best;
    };

    let raf;
    track.addEventListener('scroll',() => {
      if (raf) cancelAnimationFrame(raf);
      raf=requestAnimationFrame(() => activate(nearestCard()));
    },{passive:true});

    dots.forEach((dot,index) => {
      dot.addEventListener('click',() => {
        track.scrollTo({left:cards[index].offsetLeft,behavior:'smooth'});
        activate(index);
      });
    });

    window.addEventListener('resize',() => activate(nearestCard()));

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => activate(0));
    } else {
      activate(0);
    }
  })();
</script>

<script>
  (() => {
    const root=document.getElementById('kuks-testimonials-{{ section.id }}');
    if(!root) return;
    const setup=()=>{
      root.querySelectorAll('[data-kuks-expand-wrap]').forEach(wrap=>{
        const text=wrap.querySelector('[data-kuks-expand-text]');
        const btn=wrap.querySelector('[data-kuks-expand-btn]');
        if(!text||!btn) return;
        text.classList.add('is-collapsed');
        requestAnimationFrame(()=>{
          const needsMore=text.scrollHeight>text.clientHeight+2;
          btn.classList.toggle('is-visible',needsMore);
          if(!needsMore) text.classList.remove('is-collapsed');
        });
        if(btn.dataset.bound==='1') return;
        btn.dataset.bound='1';
        btn.addEventListener('click',()=>{
          const expanded=btn.getAttribute('aria-expanded')==='true';
          btn.setAttribute('aria-expanded',expanded?'false':'true');
          btn.textContent=expanded?'Voir plus':'Voir moins';
          text.classList.toggle('is-collapsed',expanded);
          requestAnimationFrame(()=>window.dispatchEvent(new Event('resize')));
        });
      });
    };
    setup();
    document.addEventListener('shopify:section:load',setup);
  })();
</script>

{% schema %}
{"name":"Avis clients - KUKS","max_blocks":12,"settings":[{"type":"color","id":"background","label":"Couleur du fond","default":"#ffffff"},{"type":"text","id":"heading","label":"Titre","default":"AVIS CLIENTS"}],"blocks":[{"type":"review","name":"Avis client","settings":[{"type":"image_picker","id":"avatar","label":"Photo du client"},{"type":"text","id":"name","label":"Nom","default":"Prénom N."},{"type":"text","id":"country","label":"Pays","default":"France"},{"type":"range","id":"rating","label":"Note","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"review","label":"Avis","default":"Écrivez l'avis client ici."}]}],"presets":[{"name":"Avis clients - KUKS","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]}
{% endschema %}