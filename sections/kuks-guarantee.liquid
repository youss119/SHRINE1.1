{% comment %}KUKS — garantie 60 jours compacte.{% endcomment %}
<section id="kuks-guarantee-{{ section.id }}" class="kuks-guarantee" style="background:{{ section.settings.background }};">
  <div class="kuks-guarantee__inner">
    <div class="kuks-guarantee__card" style="--card:{{ section.settings.card_background }};--accent:{{ section.settings.accent }};">
      <div class="kuks-guarantee__stars">★★★★★</div>
      <h2>{{ section.settings.heading }}</h2>
      <div class="kuks-guarantee__copy">{{ section.settings.text }}</div>
      {% if section.settings.footer_text != blank %}
        <div class="kuks-guarantee__footer"><span>★★★★★</span><strong>{{ section.settings.footer_text }}</strong></div>
      {% endif %}
    </div>
  </div>
</section>
<style>
#kuks-guarantee-{{ section.id }}{padding:18px 0 22px}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__inner{width:min(100%,520px);margin:auto;padding:0 13px}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__card{overflow:hidden;border-radius:20px;background:var(--card);color:#fff;text-align:center;box-shadow:0 8px 24px rgba(17,61,107,.09)}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__stars{padding-top:17px;color:var(--accent);font-size:14px;letter-spacing:2px}
#kuks-guarantee-{{ section.id }} h2{margin:9px auto 12px;max-width:410px;padding:0 16px;color:#fff;font-size:23px;line-height:1.08;letter-spacing:-.03em}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__copy{max-width:420px;margin:0 auto;padding:0 18px 17px;color:rgba(255,255,255,.92);font-size:11.3px;line-height:1.52}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__copy p{margin:0 0 8px}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__footer{display:grid;gap:3px;background:rgba(255,255,255,.08);padding:10px 14px;border-top:1px solid rgba(255,255,255,.12)}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__footer span{color:var(--accent);font-size:11px;letter-spacing:2px}
#kuks-guarantee-{{ section.id }} .kuks-guarantee__footer strong{font-size:8.8px;letter-spacing:.07em;text-transform:uppercase}
@media(max-width:749px){
  #kuks-guarantee-{{ section.id }}{padding:14px 0 18px}
  #kuks-guarantee-{{ section.id }} .kuks-guarantee__inner{max-width:430px}
  #kuks-guarantee-{{ section.id }} .kuks-guarantee__card{border-radius:17px}
  #kuks-guarantee-{{ section.id }} h2{font-size:21px}
  #kuks-guarantee-{{ section.id }} .kuks-guarantee__copy{font-size:10.7px;line-height:1.48}
}
</style>
{% schema %}
{"name":"Garantie 60j - KUKS","settings":[{"type":"color","id":"background","label":"Couleur du fond","default":"#ffffff"},{"type":"color","id":"card_background","label":"Couleur de la carte","default":"#0f2f63"},{"type":"color","id":"accent","label":"Couleur des étoiles","default":"#f5c400"},{"type":"text","id":"heading","label":"Titre","default":"Garantie « Peau lisse » de 60 jours"},{"type":"richtext","id":"text","label":"Texte","default":"<p>Nous vous laissons 60 jours pour intégrer la formule à votre routine et observer son évolution sur plusieurs semaines.</p><p>Si elle ne vous convient pas, vous pouvez faire valoir la garantie selon les conditions de votre boutique.</p>"},{"type":"text","id":"footer_text","label":"Texte du bandeau","default":"PLUS DE 10 000 CLIENTS SATISFAITS"}],"presets":[{"name":"Garantie 60j - KUKS"}]}
{% endschema %}