{% liquid
  assign bg = section.settings.background
  assign text = section.settings.text_color
%}

<style>
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust {
    width: 100%;
    background: {{ bg }};
    color: {{ text }};
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__inner {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    min-height: 76px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__item {
    position: relative;
    min-width: 0;
    height: 58px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 8px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 3px;
    right: 0;
    width: 1px;
    height: 52px;
    background: {{ text }};
    opacity: .95;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__icon {
    width: 25px;
    height: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__icon svg {
    width: 25px;
    height: 25px;
    display: block;
    stroke: currentColor;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__stars {
    height: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__stars span {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 20px;
    line-height: 1;
    color: currentColor;
    letter-spacing: 0;
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .kuks-goda-trust__label {
    margin: 0;
    padding: 0 4px;
    color: inherit;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.2px;
    white-space: nowrap;
  }

  @media (max-width: 390px) {
    #shopify-section-{{ section.id }} .kuks-goda-trust__inner {
      min-height: 72px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__item {
      height: 56px;
      gap: 6px;
      padding: 0 3px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__label {
      font-size: 10.2px;
      letter-spacing: -0.3px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__stars span {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__icon,
    #shopify-section-{{ section.id }} .kuks-goda-trust__icon svg {
      width: 23px;
      height: 23px;
    }
  }

  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .kuks-goda-trust__inner {
      min-height: 78px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__label {
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .kuks-goda-trust__stars span {
      font-size: 21px;
    }
  }
</style>

<div class="kuks-goda-trust" role="region" aria-label="Avantages boutique">
  <div class="kuks-goda-trust__inner">
    <div class="kuks-goda-trust__item">
      <div class="kuks-goda-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <path d="M5.7 10.8C6.9 6.2 10.8 3.8 16 3.8s9.1 2.4 10.3 7" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M5.7 10.8c1.7-1.6 3.4-1.6 5.1 0 1.7-1.6 3.4-1.6 5.2 0 1.7-1.6 3.4-1.6 5.2 0 1.7-1.6 3.4-1.6 5.1 0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M10.8 10.8 13.2 17M16 10.8V17M21.2 10.8 18.8 17M26.3 10.8 20.2 17" stroke-width="1.35" stroke-linecap="round"/>
          <rect x="11.6" y="17" width="8.8" height="9" rx=".9" stroke-width="1.5"/>
          <path d="M16 17v9M11.6 20h8.8" stroke-width="1.2"/>
          <circle cx="16" cy="23.3" r="1.05" stroke-width="1.1"/>
        </svg>
      </div>
      <p class="kuks-goda-trust__label">{{ section.settings.left_text }}</p>
    </div>

    <div class="kuks-goda-trust__item">
      <div class="kuks-goda-trust__stars" aria-hidden="true"><span>★★★★★</span></div>
      <p class="kuks-goda-trust__label">{{ section.settings.center_text }}</p>
    </div>

    <div class="kuks-goda-trust__item">
      <div class="kuks-goda-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <path d="M24.4 8.8a10.4 10.4 0 1 0 2.7 9.4" stroke-width="1.55" stroke-linecap="round"/>
          <path d="M21.1 6.9h4.4v4.4" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="11.3" y="12.6" width="9.4" height="9.8" rx="1.1" stroke-width="1.5"/>
          <path d="M13.2 12.6l1.4-2.2h2.8l1.4 2.2M11.3 15.8h9.4" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <p class="kuks-goda-trust__label">{{ section.settings.right_text }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Barre confiance GODA",
  "tag": "section",
  "class": "section-goda-trust",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "left_text",
      "label": "Texte gauche",
      "default": "Livraison offerte"
    },
    {
      "type": "text",
      "id": "center_text",
      "label": "Texte centre",
      "default": "Déjà +95 000 clients"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Texte droite",
      "default": "Retours faciles"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fond",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte et icônes",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Barre confiance GODA"
    }
  ]
}
{% endschema %}