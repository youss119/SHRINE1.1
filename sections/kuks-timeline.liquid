{% comment %}KUKS — timeline mobile centrée, proche du rythme de la référence.{% endcomment %}
<section id="kuks-timeline-{{ section.id }}" class="kuks-timeline">
  <div class="kuks-timeline__inner">
    <h2>{{ section.settings.heading }}</h2>
    <div class="kuks-timeline__list">
      {% for block in section.blocks %}
        <article class="kuks-timeline__step" {{ block.shopify_attributes }}>
          <div class="kuks-timeline__rail"><span>✓</span></div>
          <span class="kuks-timeline__badge">{{ block.settings.period }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
<style>
#kuks-timeline-{{ section.id }}{background:#fff;padding:28px 0 30px}
#kuks-timeline-{{ section.id }} .kuks-timeline__inner{width:min(100%,720px);margin:auto;padding:0 14px}
#kuks-timeline-{{ section.id }} h2{margin:0 auto 26px;max-width:650px;text-align:center;font-size:33px;line-height:1.14;letter-spacing:-.035em;color:#555}
#kuks-timeline-{{ section.id }} .kuks-timeline__list{max-width:620px;margin:auto}
#kuks-timeline-{{ section.id }} .kuks-timeline__step{position:relative;text-align:center;padding:0 0 30px}
#kuks-timeline-{{ section.id }} .kuks-timeline__step:not(:last-child)::after{content:"";position:absolute;left:50%;top:31px;bottom:0;width:2px;background:#113d6b;transform:translateX(-50%)}
#kuks-timeline-{{ section.id }} .kuks-timeline__rail{position:relative;z-index:2;display:flex;justify-content:center;margin-bottom:8px}
#kuks-timeline-{{ section.id }} .kuks-timeline__rail span{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#113d6b;color:#fff;font-size:12px;font-weight:800;box-shadow:0 0 0 6px #fff}
#kuks-timeline-{{ section.id }} .kuks-timeline__badge{position:relative;z-index:2;display:inline-flex;border:1px solid #222;border-radius:999px;padding:4px 12px;background:#fff;margin-bottom:10px;font-size:10px;line-height:1;color:#111}
#kuks-timeline-{{ section.id }} h3{position:relative;z-index:2;margin:0 0 9px;color:#113d6b;font-size:21px;line-height:1.18;font-weight:500}
#kuks-timeline-{{ section.id }} p{position:relative;z-index:2;margin:0 auto;max-width:560px;background:#fff;padding:0 8px;font-size:13px;line-height:1.55;color:#30353a}
@media(max-width:749px){#kuks-timeline-{{ section.id }} h2{font-size:29px}#kuks-timeline-{{ section.id }} h3{font-size:19px}#kuks-timeline-{{ section.id }} p{font-size:12.6px}}
</style>
{% schema %}
{"name":"Timeline résultats - KUKS","max_blocks":6,"settings":[{"type":"textarea","id":"heading","label":"Titre","default":"À quoi peut ressembler une utilisation quotidienne"}],"blocks":[{"type":"step","name":"Étape","settings":[{"type":"text","id":"period","label":"Période","default":"Semaines 1–2"},{"type":"text","id":"title","label":"Titre","default":"Vous ressentez la différence"},{"type":"textarea","id":"text","label":"Texte","default":"Décrivez ici ce que la personne peut observer au fil de la routine."}]}],"presets":[{"name":"Timeline résultats - KUKS","blocks":[{"type":"step"},{"type":"step"},{"type":"step"},{"type":"step"}]}]}
{% endschema %}